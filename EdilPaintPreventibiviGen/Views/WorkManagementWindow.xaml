<Window x:Class="EdilPaintPreventibiviGen.Views.WorkManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EdilPaintPreventibiviGen.Views"
        Title="Gestione lavori · Calendario, ordini e storico" Width="1560" Height="940"
        MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="{StaticResource ShellBackgroundBrush}"
        Icon="pack://application:,,,/Assets/Windowsicon/main.ico">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource NeutralButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource WhiteBrush}" Padding="18,12,18,6" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBlock Text="Gestione lavori" FontSize="24" FontWeight="Bold" Margin="0,0,28,6" VerticalAlignment="Center"/>
                <Button x:Name="BtnExpand" Content="Allarga sezione" Click="OnExpandClick" ToolTip="Mostra la sezione a tutta larghezza oppure torna al calendario affiancato"/>
                <Button x:Name="BtnDetachCalendar" Content="Separa calendario ↗" Click="OnDetachCalendarClick"/>
                <Button Content="Aggiorna tutto" Click="OnRefreshClick"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource PrimaryBlueBrush}" BorderThickness="4,0,0,0" Padding="14,10" Margin="10,10,10,0">
            <StackPanel>
                <TextBlock x:Name="TxtSelectedSite" Text="Seleziona un cantiere" FontSize="21" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtSelectedInfo" Text="Scegli un ordine, un preventivo o un intervento: le azioni qui sotto seguono la selezione."
                           FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                <WrapPanel x:Name="ContextToolbar">
                    <views:QuoteActionsControl x:Name="CommonActions" ShowDetails="False" UseLargeButtons="True" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPlan" Content="Programma" ToolTip="Programma un nuovo intervento per il cantiere selezionato" Click="OnPlanClick"/>
                    <Button x:Name="BtnEditEntry" Content="Modifica intervento" Click="OnEditEntryClick"/>
                    <Button x:Name="BtnMaterials" Content="Materiali" ToolTip="Modifica fornitore, stato e date dei materiali" Click="OnMaterialsClick"/>
                    <Button x:Name="BtnCosts" Content="Costi e guadagno" Click="OnCostsClick"/>
                    <Button x:Name="BtnShowQuote" Content="Vai allo storico" Click="OnShowQuoteClick"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CalendarColumn" Width="*" MinWidth="360"/>
                <ColumnDefinition x:Name="DividerColumn" Width="8"/>
                <ColumnDefinition x:Name="SideColumn" Width="600" MinWidth="380"/>
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="CalendarHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            <GridSplitter x:Name="WorkspaceSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          DragCompleted="OnSplitResized" ResizeBehavior="PreviousAndNext" Background="{StaticResource SubtleBorderBrush}" ToolTip="Trascina per ridimensionare calendario e sezione"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{StaticResource WhiteBrush}" Padding="10" Margin="0,0,0,6">
                    <WrapPanel>
                        <RadioButton x:Name="BtnOrdersTab" GroupName="Section" Content="Ordini" Checked="OnSectionChanged" IsChecked="True"/>
                        <RadioButton x:Name="BtnHistoryTab" GroupName="Section" Content="Storico" Checked="OnSectionChanged"/>
                        <Button Content="Separa ↗" Click="OnDetachSectionClick" Margin="10,0,0,0" ToolTip="Sposta questa sezione in una finestra indipendente; chiudila per riagganciarla"/>
                    </WrapPanel>
                </Border>
                <Grid Grid.Row="1">
                    <ContentControl x:Name="OrdersHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    <ContentControl x:Name="HistoryHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
                    <Button x:Name="BtnDetached" Content="Sezione aperta in una finestra separata · Riaggancia"
                            Visibility="Collapsed" Click="OnReattachClick" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="TxtWorkspaceStatus" Margin="18,0,18,10" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                   Text="Clic per selezionare · Doppio clic sul calendario per modificare · Chiudi una finestra separata per riagganciarla"/>
    </Grid>
</Window>
