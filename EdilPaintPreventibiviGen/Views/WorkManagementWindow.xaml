<Window x:Class="EdilPaintPreventibiviGen.Views.WorkManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EdilPaintPreventibiviGen.Views"
        Title="Gestione lavori" Width="1560" Height="940"
        MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="{StaticResource ShellBackgroundBrush}"
        Icon="pack://application:,,,/Assets/Windowsicon/main.ico">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource NeutralButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource DarkNavyBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBlueBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="WorkspaceRoot" Background="{StaticResource ShellBackgroundBrush}" SizeChanged="OnWorkspaceSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource WhiteBrush}" Padding="18,12,18,8" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Lavori" FontSize="24" FontWeight="Bold" Margin="0,0,24,4" VerticalAlignment="Center"/>
                <RadioButton x:Name="BtnCalendarTab" GroupName="Section" Content="Calendario" Checked="OnSectionChanged" IsChecked="True" Margin="0,0,6,4"/>
                <RadioButton x:Name="BtnOrdersTab" GroupName="Section" Content="Ordini" Checked="OnSectionChanged" Margin="0,0,6,4"/>
                <RadioButton x:Name="BtnHistoryTab" GroupName="Section" Content="Storico" Checked="OnSectionChanged" Margin="0,0,24,4"/>
                <CheckBox x:Name="ChkSideBySide" Content="Vista affiancata" VerticalAlignment="Center" Margin="0,0,20,4"
                          Checked="OnLayoutChanged" Unchecked="OnLayoutChanged" ToolTip="Mostra calendario e ordini insieme; trascina il divisore per regolare lo spazio"/>
                <Button Content="Aggiorna" Click="OnRefreshClick"/>
                <Button Content="Finestra ▾" Click="OnWindowMenuClick">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="BtnDetachCalendar" Header="Separa calendario" Click="OnDetachCalendarClick"/>
                            <MenuItem Header="Separa la sezione aperta" Click="OnDetachSectionClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource PrimaryBlueBrush}" BorderThickness="4,0,0,0" Padding="14,10" Margin="10,10,10,0">
            <StackPanel>
                <TextBlock x:Name="TxtSelectionLabel" Text="LAVORO SELEZIONATO" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtSelectedSite" Text="Seleziona un cantiere" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtSelectedInfo" Text="Scegli un ordine, un preventivo o un intervento: le azioni qui sotto seguono la selezione."
                           FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                <WrapPanel x:Name="ContextToolbar">
                    <views:QuoteActionsControl x:Name="CommonActions" ShowDetails="False" UseLargeButtons="True" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPlan" Content="Programma intervento" Background="{StaticResource PrimaryBlueBrush}" Foreground="{StaticResource WhiteBrush}" ToolTip="Programma un nuovo intervento per il cantiere selezionato" Click="OnPlanClick"/>
                    <Button x:Name="BtnEditEntry" Content="Modifica intervento" Click="OnEditEntryClick"/>
                    <Button x:Name="BtnMaterials" Content="Dettagli materiali" ToolTip="Modifica fornitore, stato e date dei materiali" Click="OnMaterialsClick"/>
                    <Button x:Name="BtnCosts" Content="Costi e guadagno" Click="OnCostsClick"/>
                    <Button x:Name="BtnShowQuote" Content="Vai allo storico" Click="OnShowQuoteClick" Visibility="Collapsed"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CalendarColumn" Width="*" MinWidth="360"/>
                <ColumnDefinition x:Name="DividerColumn" Width="8"/>
                <ColumnDefinition x:Name="SideColumn" Width="600" MinWidth="380"/>
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="CalendarHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            <GridSplitter x:Name="WorkspaceSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          DragCompleted="OnSplitResized" ResizeBehavior="PreviousAndNext" Background="{StaticResource SubtleBorderBrush}" ToolTip="Trascina per ridimensionare calendario e sezione"/>
            <Grid x:Name="SidePane" Grid.Column="2">
                <Grid>
                    <ContentControl x:Name="OrdersHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    <ContentControl x:Name="HistoryHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
                    <Button x:Name="BtnDetached" Content="Sezione aperta in una finestra separata · Riaggancia"
                            Visibility="Collapsed" Click="OnReattachClick" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="TxtWorkspaceStatus" Margin="18,0,18,10" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                   Text="Clic per selezionare · Doppio clic sul calendario per modificare · Chiudi una finestra separata per riagganciarla"/>
    </Grid>
</Window>
