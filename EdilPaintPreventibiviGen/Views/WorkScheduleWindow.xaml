<Window x:Class="EdilPaintPreventibiviGen.Views.WorkScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EdilPaintPreventibiviGen.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Programmazione lavori" Width="1280" Height="820" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" Language="it-IT">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource NeutralButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
        </Style>
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource ShellBackgroundBrush}" BorderBrush="{StaticResource WindowShadowBorderBrush}"
            BorderThickness="1" CornerRadius="14" TextElement.Foreground="{StaticResource DefaultTextBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1" Padding="22,16" MouseLeftButtonDown="OnHeaderMouseDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Click="OnCloseClick" ToolTip="Chiudi" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="Programmazione lavori" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Ordini attivi, cantieri e disponibilità · calendario condiviso"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource WhiteBrush}" Padding="22,14" Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPreviousWeek" Content="‹" Click="OnPreviousWeekClick" ToolTip="Settimana precedente" FontSize="18" Padding="12,4"/>
                        <Button x:Name="BtnToday" Content="Oggi" Click="OnTodayClick" Margin="6,0"/>
                        <Button x:Name="BtnNextWeek" Content="›" Click="OnNextWeekClick" ToolTip="Settimana successiva" FontSize="18" Padding="12,4"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtWeek" Grid.Column="1" FontSize="19" FontWeight="SemiBold"
                               Margin="18,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnAbsence" Content="Segna assenza" Click="OnAbsenceClick" Margin="0,0,8,0"/>
                        <Button x:Name="BtnRefresh" Content="Aggiorna" Click="OnRefreshClick"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Ordini attivi" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Lavori presenti nell’elenco Ordini: scegli il cantiere e assegna la squadra."
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                        </StackPanel>
                        <TextBox x:Name="TxtOrderSearch" Grid.Row="1" FontSize="14" Padding="8"
                                 TextChanged="OnOrderFilterChanged" AutomationProperties.Name="Cerca cliente, cantiere o numero ordine"
                                 ToolTip="Cerca cliente, cantiere o numero ordine"/>
                        <CheckBox x:Name="ChkUnplannedOnly" Grid.Row="2" Content="Solo da programmare" Margin="0,12,0,10"
                                  Checked="OnOrderFilterChanged" Unchecked="OnOrderFilterChanged"/>
                        <TextBlock x:Name="TxtOrderCount" Grid.Row="3" FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                        <Grid Grid.Row="4">
                            <ListBox x:Name="ItemsOrders" BorderThickness="0" Background="Transparent"
                                     SelectionChanged="OnOrderSelectionChanged" MouseDoubleClick="OnOrderDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <views:QuoteActionsControl QuoteNumber="{Binding QuoteNumber}" Margin="0,6,0,4"
                                                                          Loaded="OnQuoteActionsLoaded" Unloaded="OnQuoteActionsUnloaded"/>
                                                <TextBlock Text="{Binding CustomerName}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding QuoteNumber, StringFormat=Ordine {0}}" FontSize="12" Margin="0,5,0,0"/>
                                                <TextBlock Text="{Binding PlannedInterventions, StringFormat=Interventi programmati: {0}}"
                                                           FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="TxtNoOrders" Text="Nessun ordine attivo disponibile."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0"/>
                        </Grid>
                        <Button x:Name="BtnNewIntervention" Grid.Row="5" Content="Programma intervento" Click="OnNewInterventionClick"
                                Background="{StaticResource ModalPrimaryActionBrush}" Foreground="{StaticResource WhiteBrush}"
                                IsEnabled="False" Margin="0,14,0,0"/>
                    </Grid>
                </Border>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="ChkShowInactive" Content="Mostra interventi di ordini non attivi" Margin="0,0,0,12"
                              Checked="OnCalendarFilterChanged" Unchecked="OnCalendarFilterChanged"
                              ToolTip="Consulta anche gli interventi di ordini conclusi, eliminati o usciti dall’elenco Ordini."/>
                    <Border x:Name="ConflictNotice" Grid.Row="1" Background="{StaticResource DangerSoftBackgroundBrush}"
                            BorderBrush="{StaticResource DangerSoftBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="TxtConflictNotice" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{StaticResource DangerSoftTextBrush}"/>
                    </Border>
                    <Border x:Name="ConnectionNotice" Grid.Row="2" Background="{StaticResource WarningPanelBackgroundBrush}"
                            BorderBrush="{StaticResource WarningPanelBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="TxtConnectionNotice" TextWrapping="Wrap"/>
                    </Border>
                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsDays" MinWidth="910"
                                      Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8"
                                            Background="{Binding Background}" Margin="0,0,6,0" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding WeekDay}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding DayLabel}" FontWeight="Bold" FontSize="20" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding CountLabel}" Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11" Margin="0,5,0,12"/>
                                            <ItemsControl ItemsSource="{Binding Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,10">
                                                        <Button Style="{StaticResource CardButton}" Click="OnEntryClick" Tag="{Binding Entry}"
                                                                ToolTip="Apri intervento" Background="{Binding Background}" Margin="0,0,0,3"
                                                                BorderBrush="{Binding BorderBrush}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Entry.Title}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                                                <TextBlock Text="{Binding Entry.TimeDisplay}" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                                                <TextBlock Text="{Binding Entry.SlotDisplay}" FontSize="11" Margin="0,3,0,0"/>
                                                                <Border Background="{StaticResource SectionPanelBackgroundBrush}" CornerRadius="4"
                                                                        Padding="6" Margin="0,10,0,0">
                                                                    <TextBlock Text="{Binding Crew}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,9,0,0"/>
                                                                <Border Background="{StaticResource DangerSoftBackgroundBrush}"
                                                                        BorderBrush="{StaticResource DangerSoftBorderBrush}" BorderThickness="1"
                                                                        CornerRadius="4" Padding="6" Margin="0,8,0,0"
                                                                        Visibility="{Binding ConflictVisibility}" ToolTip="{Binding ConflictText}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="Impegni sovrapposti" FontWeight="Bold" FontSize="11" TextWrapping="Wrap"
                                                                                   Foreground="{StaticResource DangerSoftTextBrush}"/>
                                                                        <TextBlock Text="{Binding ConflictText}" TextWrapping="Wrap" FontSize="11"
                                                                                   MaxHeight="72" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                                                   Foreground="{StaticResource DangerSoftTextBrush}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Background="{StaticResource WarningPanelBackgroundBrush}"
                                                                        BorderBrush="{StaticResource WarningPanelBorderBrush}" BorderThickness="1"
                                                                        CornerRadius="4" Padding="6" Margin="0,8,0,0"
                                                                        Visibility="{Binding OrderWarningVisibility}">
                                                                    <TextBlock Text="{Binding OrderWarning}" TextWrapping="Wrap" FontSize="11"
                                                                               FontWeight="SemiBold" Foreground="{StaticResource DefaultTextBrush}"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding MaterialWarning}" TextWrapping="Wrap" FontSize="11"
                                                                           Foreground="{StaticResource DangerRedBrush}" Margin="0,5,0,0"
                                                                           Visibility="{Binding MaterialWarningVisibility}"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <views:QuoteActionsControl QuoteNumber="{Binding Entry.QuoteNumber}" ScheduleEntry="{Binding Entry}"
                                                                                  Visibility="{Binding DocumentActionsVisibility}"
                                                                                  Loaded="OnQuoteActionsLoaded" Unloaded="OnQuoteActionsUnloaded"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Libero" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                                       Margin="0,8,0,0" Visibility="{Binding EmptyVisibility}"/>
                                            <Button Content="+ Intervento" Click="OnAddForDayClick" Tag="{Binding Date}"
                                                    Padding="6,8" Margin="0,12,0,0" IsEnabled="{Binding CanEdit}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <Border Grid.Row="3" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0"
                    Background="{StaticResource WhiteBrush}" Padding="22,10">
                <DockPanel>
                    <TextBlock x:Name="TxtSyncStatus" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                    <TextBlock Text="Apri un intervento per modificarlo · PDF e Azioni sono disponibili direttamente sui cantieri."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,14,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
