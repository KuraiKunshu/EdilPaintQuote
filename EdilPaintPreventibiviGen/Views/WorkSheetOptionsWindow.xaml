<Window x:Class="EdilPaintPreventibiviGen.Views.WorkSheetOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Scheda lavoro" Width="720" Height="840" MinWidth="600" MinHeight="540"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" Language="it-IT">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource NeutralButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
        </Style>
        <Style x:Key="FieldTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource RowBackgroundBrush}" BorderBrush="{StaticResource WindowShadowBorderBrush}"
            BorderThickness="1" CornerRadius="14" TextElement.Foreground="{StaticResource DefaultTextBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource ModalFieldBorderBrush}" BorderThickness="0,0,0,1" Padding="24,18"
                    MouseLeftButtonDown="OnHeaderMouseDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Click="OnCancelClick" ToolTip="Chiudi" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="Prepara la scheda lavoro" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtQuote" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20">
                    <TextBlock Text="Tutti i campi sono facoltativi. Se li lasci vuoti, nel PDF troverai lo spazio per scrivere a penna."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,20"/>
                    <TextBlock Text="Chi esegue il lavoro" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Cerca per nome o cognome e spunta le persone. Le selezioni restano anche cambiando ricerca."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Cancella ricerca" Click="OnClearEmployeeSearchClick" Margin="8,0,0,0"/>
                        <TextBox x:Name="TxtEmployeeSearch" TextChanged="OnEmployeeSearchChanged" FontSize="14" Padding="10,7"
                                 AutomationProperties.Name="Cerca dipendenti per nome o cognome" ToolTip="Cerca per nome o cognome"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock x:Name="TxtEmployeeResults" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}"/>
                        <CheckBox x:Name="ChkSelectedOnly" Content="Mostra solo selezionati" Checked="OnSelectedOnlyChanged" Unchecked="OnSelectedOnlyChanged"/>
                    </DockPanel>
                    <Border BorderBrush="{StaticResource ModalFieldBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Background="{StaticResource WhiteBrush}" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="TxtNoEmployees" Text="Nessun dipendente configurato. Puoi aggiungerli in Impostazioni → Dipendenti oppure compilare la squadra a penna."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="TxtNoResults" Text="Nessun risultato. Modifica la ricerca o disattiva il filtro dei selezionati."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"/>
                                <ListBox x:Name="ItemsEmployees" Height="130" BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Focusable" Value="False"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      FontSize="14" Padding="6,5" Margin="0,2"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SectionPanelBackgroundBrush}" Padding="12" CornerRadius="6" Margin="0,8,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Svuota squadra" Click="OnClearEmployeesClick" Padding="8,3"/>
                                <TextBlock x:Name="TxtSelectedCount" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ScrollViewer MaxHeight="65" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                <TextBlock x:Name="TxtSelectedNames" TextWrapping="Wrap" FontSize="14"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Data intervento" FontSize="18" FontWeight="Bold" Margin="0,18,0,8"/>
                    <DockPanel HorizontalAlignment="Left">
                        <DatePicker x:Name="InterventionDatePicker" Width="200" SelectedDateFormat="Short"
                                    FontSize="18" FontWeight="SemiBold" VerticalContentAlignment="Center" DateValidationError="OnDateValidationError"
                                    PreviewTextInput="OnDateEdited" PreviewKeyDown="OnDateKeyDown" SelectedDateChanged="OnDateSelected"
                                    CalendarClosed="OnDateCalendarClosed"/>
                        <Button Content="Svuota" Margin="10,0,0,0" Click="OnClearDateClick"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtDateError" Foreground="{StaticResource DangerRedBrush}" TextWrapping="Wrap"
                               Visibility="Collapsed" Margin="0,5,0,0"/>
                    <TextBlock Text="Note aggiuntive per l'intervento" Style="{StaticResource FieldTitle}" Margin="0,20,0,8"/>
                    <TextBox x:Name="TxtAdditionalNotes" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10"
                             FontSize="14" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource ModalFieldBorderBrush}"/>
                    <TextBlock Text="Saranno stampate nella scheda, insieme alle note già presenti nel preventivo."
                               TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,7,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource ModalFieldBorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annulla" IsCancel="True" Click="OnCancelClick" Margin="0,0,12,0"/>
                    <Button Content="Genera PDF" Click="OnGenerateClick" Background="{StaticResource ModalPrimaryActionBrush}"
                            Foreground="{StaticResource WhiteBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
