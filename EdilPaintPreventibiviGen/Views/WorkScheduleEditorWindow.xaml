<Window x:Class="EdilPaintPreventibiviGen.Views.WorkScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EdilPaintPreventibiviGen.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Programma intervento" Width="760" Height="900" MinWidth="610" MinHeight="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" Language="it-IT">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource NeutralButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
        </Style>
        <Style x:Key="FieldTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,18,0,9"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource RowBackgroundBrush}" BorderBrush="{StaticResource WindowShadowBorderBrush}"
            BorderThickness="1" CornerRadius="14" TextElement.Foreground="{StaticResource DefaultTextBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource ModalFieldBorderBrush}" BorderThickness="0,0,0,1" Padding="24,18"
                    MouseLeftButtonDown="OnHeaderMouseDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Click="OnCancelClick" ToolTip="Chiudi" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtTitle" Text="Programma intervento" FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtSubtitle" Text="Salvataggio nel calendario condiviso" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,5,12,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,14,24,20">
                    <Border x:Name="ReadOnlyNotice" Background="{StaticResource WarningPanelBackgroundBrush}"
                            BorderBrush="{StaticResource WarningPanelBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock Text="Copia locale: puoi consultare l’intervento. Per modificare la programmazione connettiti al database."
                                   TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel x:Name="EditableFields">
                        <StackPanel x:Name="OrderPanel">
                            <TextBlock Text="Cantiere / ordine" Style="{StaticResource FieldTitle}" Margin="0,4,0,9"/>
                            <ComboBox x:Name="CmbOrder" DisplayMemberPath="Display" SelectionChanged="OnOrderChanged"
                                      FontSize="15" Padding="7" AutomationProperties.Name="Ordine attivo da programmare"/>
                            <TextBlock x:Name="TxtOrderDetails" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0"/>
                            <Border x:Name="OrderWarningNotice" Background="{StaticResource WarningPanelBackgroundBrush}"
                                    BorderBrush="{StaticResource WarningPanelBorderBrush}" BorderThickness="1" CornerRadius="6"
                                    Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="TxtOrderWarning" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Puoi aggiornare le note, completare o eliminare l’intervento. La programmazione futura richiede un ordine attivo nell’elenco Ordini."
                                               TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="AbsencePanel" Visibility="Collapsed">
                            <TextBlock Text="Motivo dell’assenza" Style="{StaticResource FieldTitle}" Margin="0,4,0,9"/>
                            <TextBox x:Name="TxtAbsenceReason" MaxLength="250" Text="Indisponibilità"/>
                        </StackPanel>
                        <TextBlock Text="Quando" Style="{StaticResource FieldTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="TxtStartDateLabel" Text="Dal giorno" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                                <DatePicker x:Name="StartDate" FontSize="17" SelectedDateFormat="Short"
                                            SelectedDateChanged="OnDateChanged" DateValidationError="OnDateValidationError"
                                            PreviewTextInput="OnDateEdited" PreviewKeyDown="OnDateKeyDown" CalendarClosed="OnCalendarClosed"
                                            LostKeyboardFocus="OnDateFocusChanged"/>
                            </StackPanel>
                            <StackPanel x:Name="EndDatePanel" Grid.Column="2">
                                <TextBlock Text="Fino al giorno (incluso)" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                                <DatePicker x:Name="EndDate" FontSize="17" SelectedDateFormat="Short"
                                            SelectedDateChanged="OnDateChanged" DateValidationError="OnDateValidationError"
                                            PreviewTextInput="OnDateEdited" PreviewKeyDown="OnDateKeyDown" CalendarClosed="OnCalendarClosed"
                                            LostKeyboardFocus="OnDateFocusChanged"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TxtRangeExplanation" Text="Un intervento per ogni giorno del periodo, sabato e domenica inclusi. Potrai modificare la squadra di ciascun giorno."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="Orario" Style="{StaticResource FieldTitle}"/>
                        <ComboBox x:Name="CmbSlot" FontSize="15" Padding="7" SelectionChanged="OnSlotChanged"
                                  AutomationProperties.Name="Giornata intera, mattina, pomeriggio o orario libero">
                            <ComboBoxItem Content="Giornata intera"/>
                            <ComboBoxItem Content="Mezza giornata · mattina"/>
                            <ComboBoxItem Content="Mezza giornata · pomeriggio"/>
                            <ComboBoxItem Content="Da un’ora a un’altra"/>
                        </ComboBox>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Dalle" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtStartTime" FontSize="20" FontWeight="SemiBold" AutomationProperties.Name="Ora iniziale HH:mm"
                                         TextChanged="OnTimeChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Alle" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtEndTime" FontSize="20" FontWeight="SemiBold" AutomationProperties.Name="Ora finale HH:mm"
                                         TextChanged="OnTimeChanged"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TxtTimeExplanation" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Squadra" Style="{StaticResource FieldTitle}"/>
                        <DockPanel Margin="0,0,0,9">
                            <Button DockPanel.Dock="Right" Content="Cancella ricerca" Click="OnClearSearchClick" Margin="8,0,0,0"/>
                            <TextBox x:Name="TxtEmployeeSearch" TextChanged="OnEmployeeSearchChanged"
                                     AutomationProperties.Name="Cerca dipendenti per nome, cognome o sigla" ToolTip="Nome, cognome o sigla"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="TxtEmployeeResults" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                            <CheckBox x:Name="ChkSelectedOnly" Content="Solo selezionati" Checked="OnSelectedOnlyChanged" Unchecked="OnSelectedOnlyChanged"/>
                        </DockPanel>
                        <TextBlock x:Name="TxtAvailabilityNotice" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,9"/>
                        <Border BorderBrush="{StaticResource ModalFieldBorderBrush}" BorderThickness="1" Background="{StaticResource WhiteBrush}"
                                CornerRadius="6" Padding="8">
                            <Grid>
                                <ListBox x:Name="ItemsEmployees" Height="185" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Focusable" Value="False"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="5" Margin="0,2"
                                                      HorizontalContentAlignment="Stretch">
                                                <StackPanel ToolTip="{Binding AvailabilityDetails}">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Employee.Abbreviation}" DockPanel.Dock="Right" FontWeight="Bold"
                                                                   Foreground="{StaticResource SecondaryBlueBrush}" Margin="12,0,0,0"/>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding AvailabilityText}" Foreground="{Binding AvailabilityBrush}"
                                                               FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="TxtNoEmployees" Text="Nessun dipendente disponibile. Aggiungili in Impostazioni → Dipendenti."
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="6,8"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource SelectedTabBrush}" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Svuota squadra" Click="OnClearCrewClick" Padding="8,3"/>
                                    <TextBlock x:Name="TxtSelectedCount" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ScrollViewer MaxHeight="65" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                    <TextBlock x:Name="TxtSelectedNames" TextWrapping="Wrap" FontSize="14"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="StatusPanel">
                            <TextBlock Text="Stato dell’intervento" Style="{StaticResource FieldTitle}"/>
                            <ComboBox x:Name="CmbStatus" FontSize="14" Padding="7" SelectedIndex="0">
                                <ComboBoxItem Content="Programmato"/><ComboBoxItem Content="Finito"/>
                            </ComboBox>
                            <TextBlock Text="Completare un intervento non chiude l’ordine: potrebbero esserci altri lavori da fare."
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Note per la squadra" Style="{StaticResource FieldTitle}"/>
                        <TextBox x:Name="TxtNotes" Height="85" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    </StackPanel>
                    <Border x:Name="ErrorPanel" Background="{StaticResource DangerSoftBackgroundBrush}"
                            BorderBrush="{StaticResource DangerSoftBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="TxtError" TextWrapping="Wrap" Foreground="{StaticResource DangerSoftTextBrush}"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource ModalFieldBorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel x:Name="ExistingActions" Grid.Row="0" Margin="0,0,0,6" Visibility="Collapsed">
                        <views:QuoteActionsControl x:Name="CommonQuoteActions" Margin="0,0,8,8"/>
                        <Button x:Name="BtnDelete" Content="Elimina dal calendario" Click="OnDeleteClick" Margin="0,0,0,8"
                                Background="{StaticResource DangerSoftBackgroundBrush}" Foreground="{StaticResource DangerSoftTextBrush}"/>
                    </WrapPanel>
                <DockPanel Grid.Row="1">
                    <TextBlock x:Name="TxtBusy" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,0,12,0" TextWrapping="Wrap"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Content="Annulla" Click="OnCancelClick" Margin="0,0,12,0"/>
                        <Button x:Name="BtnSave" Content="Salva intervento" Click="OnSaveClick" Background="{StaticResource ModalPrimaryActionBrush}"
                                Foreground="{StaticResource WhiteBrush}"/>
                    </StackPanel>
                </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
