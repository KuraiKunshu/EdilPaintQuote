<Window x:Class="EdilPaintPreventibiviGen.Views.WorkScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EdilPaintPreventibiviGen.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Programma intervento" Width="1080" Height="870" MinWidth="610" MinHeight="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent" Language="it-IT">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource NeutralButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="FieldTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource RowBackgroundBrush}" BorderBrush="{StaticResource WindowShadowBorderBrush}"
            BorderThickness="1" CornerRadius="14" TextElement.Foreground="{StaticResource DefaultTextBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource ModalFieldBorderBrush}" BorderThickness="0,0,0,1" Padding="24,18"
                    MouseLeftButtonDown="OnHeaderMouseDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Click="OnCancelClick" ToolTip="Chiudi" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtTitle" Text="Programma intervento" FontSize="25" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtSubtitle" Text="Scegli il cantiere, il giorno e le persone. Tutti i PC vedranno la stessa programmazione."
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,12,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,18,24,6">
                    <Border x:Name="ReadOnlyNotice" Background="{StaticResource WarningPanelBackgroundBrush}"
                            BorderBrush="{StaticResource WarningPanelBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                        <TextBlock Text="Copia locale: puoi consultare l’intervento. Per modificare la programmazione connettiti al database."
                                   TextWrapping="Wrap"/>
                    </Border>
                    <Grid x:Name="EditableFields" SizeChanged="OnEditorBodySizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DetailsColumn" Width="*"/>
                            <ColumnDefinition x:Name="ColumnGap" Width="18"/>
                            <ColumnDefinition x:Name="CrewColumn" Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel x:Name="InterventionFields">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <StackPanel x:Name="OrderPanel">
                                        <TextBlock Text="Cantiere" Style="{StaticResource FieldTitle}"/>
                                        <StackPanel x:Name="OrderSearchPanel" Margin="0,0,0,10">
                                            <TextBlock Text="Cerca cantiere, cliente, riferimento o numero" Style="{StaticResource FieldLabel}"/>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="✕" ToolTip="Cancella ricerca cantieri" Click="OnClearOrderSearchClick"
                                                        Margin="8,0,0,0" Padding="10,7"/>
                                                <TextBox x:Name="TxtOrderSearch" TextChanged="OnOrderSearchChanged"
                                                         AutomationProperties.Name="Cerca cantiere, cliente, riferimento o numero"/>
                                            </DockPanel>
                                            <TextBlock x:Name="TxtOrderResults" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CmbOrder" SelectionChanged="OnOrderChanged" MaxDropDownHeight="330"
                                                  FontSize="15" Padding="7" AutomationProperties.Name="Ordine attivo da programmare"
                                                  ToolTip="{Binding SelectedItem.Display, RelativeSource={RelativeSource Self}}"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="8"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel MaxWidth="370">
                                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding ReferenceDetail}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock"><Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ReferenceDetail}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                </Style.Triggers></Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding CustomerDetail}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding QuoteNumber, StringFormat=Ordine {0}}" FontSize="12" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock x:Name="TxtOrderDetails" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,9,0,0"/>
                                        <Border x:Name="OrderWarningNotice" Background="{StaticResource WarningPanelBackgroundBrush}"
                                                BorderBrush="{StaticResource WarningPanelBorderBrush}" BorderThickness="1" CornerRadius="6"
                                                Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtOrderWarning" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Puoi aggiornare le note, completare o eliminare l’intervento. La programmazione futura richiede un ordine attivo nell’elenco Ordini."
                                                           TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel x:Name="AbsencePanel" Visibility="Collapsed">
                                        <TextBlock Text="Motivo dell’assenza" Style="{StaticResource FieldTitle}"/>
                                        <TextBox x:Name="TxtAbsenceReason" MaxLength="250" Text="Indisponibilità" TextChanged="OnSummaryFieldChanged"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Giorni e orario" Style="{StaticResource FieldTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="TxtStartDateLabel" Text="Dal giorno" Style="{StaticResource FieldLabel}"/>
                                            <DatePicker x:Name="StartDate" FontSize="15" SelectedDateFormat="Short"
                                                        SelectedDateChanged="OnDateChanged" DateValidationError="OnDateValidationError"
                                                        PreviewTextInput="OnDateEdited" PreviewKeyDown="OnDateKeyDown" CalendarClosed="OnCalendarClosed"
                                                        LostKeyboardFocus="OnDateFocusChanged"/>
                                        </StackPanel>
                                        <StackPanel x:Name="EndDatePanel" Grid.Column="2">
                                            <TextBlock Text="Fino al giorno (incluso)" Style="{StaticResource FieldLabel}"/>
                                            <DatePicker x:Name="EndDate" FontSize="15" SelectedDateFormat="Short"
                                                        SelectedDateChanged="OnDateChanged" DateValidationError="OnDateValidationError"
                                                        PreviewTextInput="OnDateEdited" PreviewKeyDown="OnDateKeyDown" CalendarClosed="OnCalendarClosed"
                                                        LostKeyboardFocus="OnDateFocusChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TxtRangeExplanation" Text="Un intervento al giorno, anche sabato e domenica. La squadra potrà essere modificata per ciascun giorno."
                                               Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,14"/>
                                    <TextBlock Text="Fascia oraria" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="CmbSlot" FontSize="14" Padding="7" SelectionChanged="OnSlotChanged"
                                              AutomationProperties.Name="Giornata intera, mattina, pomeriggio o orario libero">
                                        <ComboBoxItem Content="Giornata intera"/>
                                        <ComboBoxItem Content="Mattina"/>
                                        <ComboBoxItem Content="Pomeriggio"/>
                                        <ComboBoxItem Content="Orario libero"/>
                                    </ComboBox>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Dalle" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtStartTime" FontSize="22" FontWeight="SemiBold" AutomationProperties.Name="Ora iniziale HH:mm" TextChanged="OnTimeChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Alle" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtEndTime" FontSize="22" FontWeight="SemiBold" AutomationProperties.Name="Ora finale HH:mm" TextChanged="OnTimeChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TxtTimeExplanation" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Note e stato" Style="{StaticResource FieldTitle}"/>
                                    <TextBlock Text="Indicazioni per la squadra (facoltative)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtNotes" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                    <StackPanel x:Name="StatusPanel" Margin="0,14,0,0">
                                        <TextBlock Text="Stato dell’intervento" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CmbStatus" FontSize="14" Padding="7" SelectedIndex="0" SelectionChanged="OnStatusChanged">
                                            <ComboBoxItem Content="Programmato"/><ComboBoxItem Content="Finito"/>
                                        </ComboBox>
                                        <TextBlock Text="Lo stato riguarda solo questo intervento. L’ordine potrebbe avere altri lavori da fare."
                                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border x:Name="CrewSection" Grid.Column="2" Style="{StaticResource SectionCard}" VerticalAlignment="Top">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="TxtSelectedCount" DockPanel.Dock="Right" Foreground="{StaticResource SecondaryBlueBrush}"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Text="Squadra" Style="{StaticResource FieldTitle}" Margin="0"/>
                                </DockPanel>
                                <TextBlock Text="Cerca nome, cognome o sigla" Style="{StaticResource FieldLabel}"/>
                                <DockPanel Margin="0,0,0,9">
                                    <Button DockPanel.Dock="Right" Content="✕" ToolTip="Cancella ricerca dipendenti" Click="OnClearSearchClick" Margin="8,0,0,0" Padding="10,7"/>
                                    <TextBox x:Name="TxtEmployeeSearch" TextChanged="OnEmployeeSearchChanged"
                                             AutomationProperties.Name="Cerca dipendenti per nome, cognome o sigla"/>
                                </DockPanel>
                                <WrapPanel Margin="0,0,0,7">
                                    <CheckBox x:Name="ChkAvailableOnly" Content="Senza impegni noti" Checked="OnAvailabilityFilterChanged" Unchecked="OnAvailabilityFilterChanged"
                                              ToolTip="Mostra le persone senza sovrapposizioni nel calendario caricato. Le persone già selezionate restano visibili."
                                              Margin="0,0,14,7"/>
                                    <CheckBox x:Name="ChkSelectedOnly" Content="Solo selezionati" Checked="OnSelectedOnlyChanged" Unchecked="OnSelectedOnlyChanged" Margin="0,0,0,7"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtEmployeeResults" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                                <Border BorderBrush="{StaticResource ModalFieldBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="5">
                                    <Grid>
                                        <ListBox x:Name="ItemsEmployees" Height="240" BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/></Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="6" Margin="0,2" HorizontalContentAlignment="Stretch">
                                                        <StackPanel ToolTip="{Binding AvailabilityDetails}">
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding Employee.Abbreviation}" DockPanel.Dock="Right" FontWeight="Bold"
                                                                           Foreground="{StaticResource SecondaryBlueBrush}" Margin="10,0,0,0"/>
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="15" TextWrapping="Wrap"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding AvailabilityText}" Foreground="{Binding AvailabilityBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="TxtNoEmployees" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="6,8"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="TxtAvailabilityNotice" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,9,0,14"/>
                                <Border Background="{StaticResource SelectedTabBrush}" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,9">
                                            <Button DockPanel.Dock="Right" Content="Svuota" ToolTip="Svuota squadra" Click="OnClearCrewClick" Padding="8,3"/>
                                            <TextBlock Text="Persone assegnate" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock x:Name="TxtSelectedNames" TextWrapping="Wrap" FontSize="13"/>
                                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="ItemsSelectedEmployees">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Click="OnRemoveEmployeeClick" Margin="0,0,6,6" Padding="8,5"
                                                                ToolTip="Rimuovi dalla squadra" AutomationProperties.Name="{Binding DisplayName, StringFormat=Rimuovi {0} dalla squadra}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayName}" MaxWidth="230" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="✕" Margin="8,0,0,0"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock x:Name="TxtCrewWarning" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource DangerSoftTextBrush}" Visibility="Collapsed" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <WrapPanel x:Name="ExistingActions" Margin="0,0,0,8" Visibility="Collapsed">
                        <views:QuoteActionsControl x:Name="CommonQuoteActions" UseLargeButtons="True" Margin="0,0,8,8"/>
                        <Button x:Name="BtnDelete" Content="Elimina dal calendario" Click="OnDeleteClick" Margin="0,0,0,8"
                                Background="{StaticResource DangerSoftBackgroundBrush}" Foreground="{StaticResource DangerSoftTextBrush}"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource ModalFieldBorderBrush}" BorderThickness="0,1,0,0"
                    Background="{StaticResource WhiteBrush}" Padding="24,12">
                <StackPanel>
                    <Border x:Name="ErrorPanel" Background="{StaticResource DangerSoftBackgroundBrush}"
                            BorderBrush="{StaticResource DangerSoftBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
                        <ScrollViewer MaxHeight="65" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="TxtError" TextWrapping="Wrap" Foreground="{StaticResource DangerSoftTextBrush}"/>
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="TxtSummaryTitle" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtSummaryDetails" FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtBusy" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,12,0" TextWrapping="Wrap"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCancel" Content="Annulla" Click="OnCancelClick" Margin="0,0,10,0"/>
                            <Button x:Name="BtnSave" Content="Salva intervento" Click="OnSaveClick" Background="{StaticResource ModalPrimaryActionBrush}" Foreground="{StaticResource WhiteBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
