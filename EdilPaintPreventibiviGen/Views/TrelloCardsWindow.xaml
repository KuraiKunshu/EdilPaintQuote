<Window x:Class="EdilPaintPreventibiviGen.Views.TrelloCardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Associa una scheda Trello al preventivo"
        Width="1120" Height="730" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBackgroundBrush}"
        Foreground="{StaticResource DefaultTextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Scegli la scheda Trello" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="L'associazione avviene solo premendo il pulsante in basso. Il cliente va scelto separatamente nel preventivo."
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="TxtCurrentAssociation" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Cerca titolo, descrizione o riferimento" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtSearch" Padding="8,6" TextChanged="OnSearchChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="Bacheca / lista" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbList" Padding="6" SelectionChanged="OnListChanged"/>
            </StackPanel>
            <CheckBox Grid.Column="2" x:Name="ChkArchived" Content="Mostra archiviate"
                      VerticalAlignment="Bottom" Margin="0,0,14,8"
                      Checked="OnArchivedChanged" Unchecked="OnArchivedChanged"/>
            <Button Grid.Column="3" x:Name="BtnRefresh" Content="Ricarica dal database"
                    Padding="12,7" VerticalAlignment="Bottom" Click="OnRefreshClick"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="GridCards" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow" RowHeaderWidth="0"
                      EnableRowVirtualization="True" SelectionChanged="OnCardSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Scheda" Binding="{Binding Card.Name}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn Header="Lista" Binding="{Binding Card.ListName}" Width="130"/>
                    <DataGridTextColumn Header="Appuntamento" Binding="{Binding Appointment}" Width="125"/>
                    <DataGridCheckBoxColumn Header="Archiviata" Binding="{Binding Card.IsArchived}" Width="75"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TxtPreviewTitle" Text="Seleziona una scheda per leggerne i dati"
                                   FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtPreviewDetails" Margin="0,8,0,10" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox x:Name="TxtPreview" IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent" AcceptsReturn="True"/>
                        <Button x:Name="BtnOpen" Content="Apri su Trello" IsEnabled="False"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,6" Click="OnOpenClick"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnRemove" Content="Rimuovi associazione" Padding="12,9" Margin="0,0,10,0"
                        Visibility="Collapsed" Click="OnRemoveClick"/>
                <Button Content="Annulla" Padding="18,9" Margin="0,0,10,0" IsCancel="True"/>
                <Button x:Name="BtnAssociate" Content="Associa al preventivo" Padding="18,9"
                        Background="{StaticResource SelectCustomerButtonBrush}" Foreground="{StaticResource WhiteBrush}"
                        IsEnabled="False" Click="OnAssociateClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
