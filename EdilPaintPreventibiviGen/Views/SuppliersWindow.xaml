<Window x:Class="EdilPaintPreventibiviGen.Views.SuppliersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fornitori"
        Width="1260"
        Height="680"
        MinWidth="1080"
        MinHeight="540"
        MaxWidth="1500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ShellBackgroundBrush}"
        Icon="pack://application:,,,/Assets/Windowsicon/main.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="StatusToOrderBackgroundBrush" Color="#FFF4F4"/>
        <SolidColorBrush x:Key="StatusToOrderBrush" Color="#B42318"/>
        <SolidColorBrush x:Key="StatusOrderedBackgroundBrush" Color="#FFF4E5"/>
        <SolidColorBrush x:Key="StatusOrderedBrush" Color="#B54708"/>
        <SolidColorBrush x:Key="StatusPickupBackgroundBrush" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="StatusPickupBrush" Color="#175CD3"/>
        <SolidColorBrush x:Key="StatusWarehouseBackgroundBrush" Color="#F4EBFF"/>
        <SolidColorBrush x:Key="StatusWarehouseBrush" Color="#6941C6"/>
        <SolidColorBrush x:Key="StatusDeliveredBackgroundBrush" Color="#ECFDF3"/>
        <SolidColorBrush x:Key="StatusDeliveredBrush" Color="#027A48"/>
        <SolidColorBrush x:Key="StatusUnavailableBackgroundBrush" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="StatusUnavailableBrush" Color="#344054"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SectionPanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource DataGridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DataGridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Da ordinare">
                    <Setter Property="Background" Value="{StaticResource StatusToOrderBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusToOrderBrush}"/>
                    <Setter Property="BorderThickness" Value="5,0,0,1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Ordinato">
                    <Setter Property="Background" Value="{StaticResource StatusOrderedBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusOrderedBrush}"/>
                    <Setter Property="BorderThickness" Value="5,0,0,1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Da ritirare">
                    <Setter Property="Background" Value="{StaticResource StatusPickupBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusPickupBrush}"/>
                    <Setter Property="BorderThickness" Value="5,0,0,1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="In magazzino">
                    <Setter Property="Background" Value="{StaticResource StatusWarehouseBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusWarehouseBrush}"/>
                    <Setter Property="BorderThickness" Value="5,0,0,1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Consegnato">
                    <Setter Property="Background" Value="{StaticResource StatusDeliveredBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusDeliveredBrush}"/>
                    <Setter Property="BorderThickness" Value="5,0,0,1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Non disponibile">
                    <Setter Property="Background" Value="{StaticResource StatusUnavailableBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusUnavailableBrush}"/>
                    <Setter Property="BorderThickness" Value="5,0,0,1"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SearchResultHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SearchResultSelectedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InlineTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="InlineComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="StatusComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource InlineComboBoxStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Da ordinare">
                    <Setter Property="Background" Value="{StaticResource StatusToOrderBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusToOrderBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusToOrderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Ordinato">
                    <Setter Property="Background" Value="{StaticResource StatusOrderedBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusOrderedBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusOrderedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Da ritirare">
                    <Setter Property="Background" Value="{StaticResource StatusPickupBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusPickupBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusPickupBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="In magazzino">
                    <Setter Property="Background" Value="{StaticResource StatusWarehouseBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusWarehouseBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusWarehouseBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Consegnato">
                    <Setter Property="Background" Value="{StaticResource StatusDeliveredBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusDeliveredBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusDeliveredBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Non disponibile">
                    <Setter Property="Background" Value="{StaticResource StatusUnavailableBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusUnavailableBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusUnavailableBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InlineDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Fornitori"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DefaultTextBrush}"/>
                    <TextBlock x:Name="TxtSubtitle"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="TxtSearch"
                             Width="260"
                             Height="36"
                             Padding="10,5"
                             VerticalContentAlignment="Center"
                             Margin="0,0,8,0"
                             KeyDown="OnSearchKeyDown"/>
                    <Button Content="Cerca"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{StaticResource DiagnosticsButtonBrush}"
                            Margin="0,0,8,0"
                            Click="OnSearchClick"/>
                    <Button Content="Aggiorna"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{StaticResource HistoryButtonBrush}"
                            Margin="0,0,8,0"
                            Click="OnRefreshClick"/>
                    <Button Content="Chiudi"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{StaticResource SettingsButtonBrush}"
                            Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <DataGrid x:Name="GridSuppliers"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      AlternationCount="2"
                      RowHeaderWidth="0"
                      Background="{StaticResource WhiteBrush}"
                      BorderBrush="{StaticResource DataGridBorderBrush}"
                      BorderThickness="1"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource DataGridLineBrush}"
                      VerticalGridLinesBrush="{StaticResource TransparentBrush}"
                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                      CellStyle="{StaticResource GridCellStyle}"
                      RowStyle="{StaticResource GridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N. Prev."
                                        Binding="{Binding QuoteNumber}"
                                        IsReadOnly="True"
                                        Width="90"/>
                    <DataGridTextColumn Header="Data"
                                        Binding="{Binding Date, StringFormat=dd/MM/yyyy}"
                                        IsReadOnly="True"
                                        Width="95"/>
                    <DataGridTextColumn Header="Cliente"
                                        Binding="{Binding CustomerReferenceDisplay}"
                                        IsReadOnly="True"
                                        Width="2*"/>
                    <DataGridTemplateColumn Header="Fornitore" Width="1.4*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource InlineTextBoxStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MaterialsOrderedByCustomer}" Value="True">
                                                        <Setter Property="IsReadOnly" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Button Grid.Column="2"
                                            Content="..."
                                            Height="32"
                                            Padding="0"
                                            Background="{StaticResource NeutralButtonBackgroundBrush}"
                                            BorderBrush="{StaticResource NeutralButtonBorderBrush}"
                                            Foreground="{StaticResource NeutralButtonTextBrush}"
                                            ToolTip="Seleziona fornitore"
                                            Click="OnSelectSupplierClick">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MaterialsOrderedByCustomer}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Ordina il cliente" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding MaterialsOrderedByCustomer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ToolTip="I materiali vengono ordinati direttamente dal cliente"
                                          Click="OnMaterialsOrderedByCustomerClick"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Data ordine" Width="135">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding MaterialOrderDate, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource InlineDatePickerStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Consegna prevista" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding ExpectedDeliveryDate, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource InlineDatePickerStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Stato materiale" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding MaterialStatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Text="{Binding MaterialStatus, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource StatusComboBoxStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="165">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Salva"
                                            Height="32"
                                            MinWidth="68"
                                            Margin="0,0,6,0"
                                            Background="{StaticResource GeneratePdfButtonBrush}"
                                            Foreground="{StaticResource WhiteBrush}"
                                            BorderThickness="0"
                                            Click="OnSaveSupplierClick"/>
                                    <Button Content="Mail"
                                            Height="32"
                                            MinWidth="62"
                                            Background="{StaticResource DiagnosticsButtonBrush}"
                                            Foreground="{StaticResource WhiteBrush}"
                                            BorderThickness="0"
                                            Click="OnPrepareOrderMailClick"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="EmptyPanel"
                    Visibility="Collapsed"
                    Background="{StaticResource OverlayBackdropBrush}">
                <TextBlock Text="Nessun ordine inviato o modificato"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource WhiteBrush}"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
