<Window x:Class="EdilPaintPreventibiviGen.Views.SuppliersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ordini" Width="1340" Height="820" MinWidth="860" MinHeight="620"
        FontSize="14" Foreground="{StaticResource DefaultTextBrush}"
        WindowStartupLocation="CenterOwner" Background="{StaticResource ShellBackgroundBrush}"
        Icon="pack://application:,,,/Assets/Windowsicon/main.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="StatusToOrderBackgroundBrush" Color="#FFF4F4"/>
        <SolidColorBrush x:Key="StatusToOrderBrush" Color="#B42318"/>
        <SolidColorBrush x:Key="StatusOrderedBackgroundBrush" Color="#FFF4E5"/>
        <SolidColorBrush x:Key="StatusOrderedBrush" Color="#B54708"/>
        <SolidColorBrush x:Key="StatusPickupBackgroundBrush" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="StatusPickupBrush" Color="#175CD3"/>
        <SolidColorBrush x:Key="StatusWarehouseBackgroundBrush" Color="#F4EBFF"/>
        <SolidColorBrush x:Key="StatusWarehouseBrush" Color="#6941C6"/>
        <SolidColorBrush x:Key="StatusDeliveredBackgroundBrush" Color="#ECFDF3"/>
        <SolidColorBrush x:Key="StatusDeliveredBrush" Color="#027A48"/>
        <SolidColorBrush x:Key="StatusUnavailableBackgroundBrush" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="StatusUnavailableBrush" Color="#344054"/>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Background" Value="{StaticResource DangerRedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="OrderCardStyle" TargetType="Button">
            <Setter Property="Width" Value="240"/>
            <Setter Property="Height" Value="240"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="ToolTip" Value="Apri i dettagli e i documenti dell'ordine"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding OrderSiteTitle}"/>
            <Setter Property="AutomationProperties.HelpText" Value="Apri i dettagli dell'ordine"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource SearchResultHoverBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource SelectedTabBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MaterialStatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource StatusUnavailableBackgroundBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource StatusUnavailableBrush}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MaterialStatusDisplay}" Value="Da ordinare">
                    <Setter Property="Background" Value="{StaticResource StatusToOrderBackgroundBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource StatusToOrderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatusDisplay}" Value="Ordinato">
                    <Setter Property="Background" Value="{StaticResource StatusOrderedBackgroundBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource StatusOrderedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatusDisplay}" Value="Da ritirare">
                    <Setter Property="Background" Value="{StaticResource StatusPickupBackgroundBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource StatusPickupBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatusDisplay}" Value="In magazzino">
                    <Setter Property="Background" Value="{StaticResource StatusWarehouseBackgroundBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource StatusWarehouseBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatusDisplay}" Value="Consegnato">
                    <Setter Property="Background" Value="{StaticResource StatusDeliveredBackgroundBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource StatusDeliveredBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ItemsPanelTemplate x:Key="CardsWrapPanel"><WrapPanel/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="SupplierGroupsPanel"><StackPanel/></ItemsPanelTemplate>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <DockPanel Margin="0,0,0,16">
                <Border DockPanel.Dock="Right" Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="18,9" VerticalAlignment="Top" Margin="16,0,0,0">
                    <TextBlock x:Name="TxtSubtitle" FontSize="18" FontWeight="SemiBold" Text="Caricamento..."/>
                </Border>
                <Border BorderBrush="{StaticResource DangerRedBrush}" BorderThickness="5,0,0,0" Padding="14,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Ordini" FontSize="32" FontWeight="Bold"/>
                        <TextBlock Text="Scegli un cantiere per aprire i dettagli dell'ordine" Margin="0,3,0,0" FontSize="15" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DockPanel>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="14,12,2,4">
                <WrapPanel>
                    <StackPanel Width="270" Margin="0,0,12,8">
                        <TextBlock Text="Cerca un ordine" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtSearch" Height="40" Padding="11,6" VerticalContentAlignment="Center"
                                 ToolTip="Cerca cliente, riferimento, numero preventivo o fornitore" KeyDown="OnSearchKeyDown"/>
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,12,8">
                        <TextBlock Text="Stato materiali" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbStatusFilter" Height="40" Padding="8,5" VerticalContentAlignment="Center"
                                  SelectionChanged="OnStatusFilterChanged"/>
                    </StackPanel>
                    <StackPanel Width="230" Margin="0,0,12,8">
                        <TextBlock x:Name="TxtSortOrderLabel" Text="Ordina per" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbSortOrder" Height="40" Padding="8,5" VerticalContentAlignment="Center"
                                  SelectionChanged="OnSortOrderChanged"/>
                    </StackPanel>
                    <Button x:Name="BtnSearch" Content="Cerca" Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,24,8,8" Click="OnSearchClick"/>
                    <Button x:Name="BtnRefresh" Content="Aggiorna" Style="{StaticResource ToolbarButtonStyle}"
                            Background="{StaticResource NeutralButtonBackgroundBrush}" Foreground="{StaticResource NeutralButtonTextBrush}"
                            Margin="0,24,12,8" Click="OnRefreshClick"/>
                </WrapPanel>
            </Border>
            <CheckBox x:Name="ChkGroupBySupplier" Content="Raggruppa per fornitore" IsChecked="True" Margin="2,12,0,0"
                      FontWeight="SemiBold" Checked="OnSupplierGroupingChanged" Unchecked="OnSupplierGroupingChanged"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="2,10,2,0" Margin="0,8,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtVisibleCount" DockPanel.Dock="Right" FontWeight="SemiBold" Margin="12,0,0,0"/>
                <TextBlock x:Name="TxtFooterStatus" Text="Apri un riquadro per modificare l'ordine o accedere ai documenti." FontSize="13" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
        <Grid>
            <ScrollViewer x:Name="OrdersScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <ItemsControl x:Name="ItemsOrders" HorizontalAlignment="Stretch" ItemsPanel="{StaticResource CardsWrapPanel}">
                    <ItemsControl.GroupStyle>
                        <GroupStyle Panel="{StaticResource SupplierGroupsPanel}">
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander IsExpanded="True" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
                                                    <Expander.Header>
                                                        <Border Background="{StaticResource SelectedTabBrush}" Padding="12,10" CornerRadius="5">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount, StringFormat=Ordini: {0}}" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                                            </DockPanel>
                                                        </Border>
                                                    </Expander.Header>
                                                    <ItemsPresenter Margin="0,10,0,0"/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource OrderCardStyle}" Click="OnOpenOrderClick">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding OrderSiteTitle}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                                               MaxHeight="96" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" ToolTip="{Binding OrderSiteTitle}"/>
                                    <Border Grid.Row="1" Style="{StaticResource MaterialStatusBadgeStyle}" Margin="0,10,0,14">
                                        <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding MaterialStatusDisplay}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MaterialStatusDisplay}" Value="-">
                                                            <Setter Property="Text" Value="Da impostare"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="Data ordine" FontSize="13"/>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding MaterialOrderDateDisplay}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MaterialOrderDateDisplay}" Value="-">
                                                            <Setter Property="Text" Value="Non indicata"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border x:Name="EmptyPanel" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                    <TextBlock Text="Nessun ordine trovato" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtEmptyDetail" Text="Nessun ordine corrisponde ai criteri selezionati." Margin="0,8,0,0" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
