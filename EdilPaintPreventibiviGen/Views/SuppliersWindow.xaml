<Window x:Class="EdilPaintPreventibiviGen.Views.SuppliersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ordini"
        Width="1340"
        Height="760"
        MinWidth="1120"
        MinHeight="620"
        MaxWidth="1680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ShellBackgroundBrush}"
        Icon="pack://application:,,,/Assets/Windowsicon/main.ico">
    <Window.Resources>
        <SolidColorBrush x:Key="StatusToOrderBackgroundBrush" Color="#FFF4F4"/>
        <SolidColorBrush x:Key="StatusToOrderBrush" Color="#B42318"/>
        <SolidColorBrush x:Key="StatusOrderedBackgroundBrush" Color="#FFF4E5"/>
        <SolidColorBrush x:Key="StatusOrderedBrush" Color="#B54708"/>
        <SolidColorBrush x:Key="StatusPickupBackgroundBrush" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="StatusPickupBrush" Color="#175CD3"/>
        <SolidColorBrush x:Key="StatusWarehouseBackgroundBrush" Color="#F4EBFF"/>
        <SolidColorBrush x:Key="StatusWarehouseBrush" Color="#6941C6"/>
        <SolidColorBrush x:Key="StatusDeliveredBackgroundBrush" Color="#ECFDF3"/>
        <SolidColorBrush x:Key="StatusDeliveredBrush" Color="#027A48"/>
        <SolidColorBrush x:Key="StatusUnavailableBackgroundBrush" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="StatusUnavailableBrush" Color="#344054"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeutralButtonBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource NeutralButtonTextBrush}"/>
        </Style>

        <Style x:Key="IconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryActionButtonStyle}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="RowActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="LegendTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SectionPanelBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource DataGridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="82"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DataGridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Da ordinare">
                    <Setter Property="Background" Value="{StaticResource StatusToOrderBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusToOrderBrush}"/>
                    <Setter Property="BorderThickness" Value="5,0,0,1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Ordinato">
                    <Setter Property="Background" Value="{StaticResource StatusOrderedBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusOrderedBrush}"/>
                    <Setter Property="BorderThickness" Value="5,0,0,1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Da ritirare">
                    <Setter Property="Background" Value="{StaticResource StatusPickupBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusPickupBrush}"/>
                    <Setter Property="BorderThickness" Value="5,0,0,1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="In magazzino">
                    <Setter Property="Background" Value="{StaticResource StatusWarehouseBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusWarehouseBrush}"/>
                    <Setter Property="BorderThickness" Value="5,0,0,1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Consegnato">
                    <Setter Property="Background" Value="{StaticResource StatusDeliveredBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusDeliveredBrush}"/>
                    <Setter Property="BorderThickness" Value="5,0,0,1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Non disponibile">
                    <Setter Property="Background" Value="{StaticResource StatusUnavailableBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusUnavailableBrush}"/>
                    <Setter Property="BorderThickness" Value="5,0,0,1"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SearchResultHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SearchResultSelectedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InlineTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="InlineComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="StatusComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource InlineComboBoxStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Da ordinare">
                    <Setter Property="Background" Value="{StaticResource StatusToOrderBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusToOrderBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusToOrderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Ordinato">
                    <Setter Property="Background" Value="{StaticResource StatusOrderedBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusOrderedBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusOrderedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Da ritirare">
                    <Setter Property="Background" Value="{StaticResource StatusPickupBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusPickupBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusPickupBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="In magazzino">
                    <Setter Property="Background" Value="{StaticResource StatusWarehouseBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusWarehouseBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusWarehouseBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Consegnato">
                    <Setter Property="Background" Value="{StaticResource StatusDeliveredBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusDeliveredBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusDeliveredBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MaterialStatus}" Value="Non disponibile">
                    <Setter Property="Background" Value="{StaticResource StatusUnavailableBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource StatusUnavailableBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource StatusUnavailableBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InlineDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{StaticResource DangerRedBrush}"
                        BorderThickness="4,0,0,0"
                        Padding="14,2,0,2">
                    <StackPanel>
                        <TextBlock Text="Ordini"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DefaultTextBrush}"/>
                        <TextBlock x:Name="TxtSubtitle"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   Text="Caricamento..."/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="1"
                        Content="&#xE711;"
                        Style="{StaticResource IconButtonStyle}"
                        VerticalAlignment="Top"
                        ToolTip="Chiudi"
                        Click="OnCloseClick"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CERCA" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="TxtSearch"
                                 Height="38"
                                 Padding="11,6"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Cerca cliente, riferimento, numero preventivo o fornitore"
                                 KeyDown="OnSearchKeyDown"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="STATO" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbStatusFilter"
                                  Height="38"
                                  Padding="8,5"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="OnStatusFilterChanged"/>
                    </StackPanel>

                    <Button x:Name="BtnSearch"
                            Grid.Column="4"
                            Content="Cerca"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{StaticResource DangerRedBrush}"
                            VerticalAlignment="Bottom"
                            Click="OnSearchClick"/>
                    <Button x:Name="BtnRefresh"
                            Grid.Column="6"
                            Content="Aggiorna"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            VerticalAlignment="Bottom"
                            Click="OnRefreshClick"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="4,10,0,0">
                <TextBlock Text="Stati"
                           Style="{StaticResource LegendTextStyle}"
                           FontWeight="SemiBold"
                           Margin="0,0,14,0"/>

                <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource StatusToOrderBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Da ordinare" Style="{StaticResource LegendTextStyle}" Margin="5,0,16,0"/>
                <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource StatusOrderedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Ordinato" Style="{StaticResource LegendTextStyle}" Margin="5,0,16,0"/>
                <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource StatusPickupBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Da ritirare" Style="{StaticResource LegendTextStyle}" Margin="5,0,16,0"/>
                <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource StatusWarehouseBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="In magazzino" Style="{StaticResource LegendTextStyle}" Margin="5,0,16,0"/>
                <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource StatusDeliveredBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Consegnato" Style="{StaticResource LegendTextStyle}" Margin="5,0,16,0"/>
                <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource StatusUnavailableBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Non disponibile" Style="{StaticResource LegendTextStyle}" Margin="5,0,0,0"/>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="2,10,2,0"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFooterStatus"
                           Text="Pronto"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock x:Name="TxtVisibleCount"
                           Grid.Column="1"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource DefaultTextBrush}"/>
            </Grid>
        </Border>

        <Grid>
            <DataGrid x:Name="GridSuppliers"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      FrozenColumnCount="1"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      AlternationCount="2"
                      RowHeaderWidth="0"
                      Background="{StaticResource WhiteBrush}"
                      BorderBrush="{StaticResource DataGridBorderBrush}"
                      BorderThickness="1"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource DataGridLineBrush}"
                      VerticalGridLinesBrush="{StaticResource TransparentBrush}"
                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                      CellStyle="{StaticResource GridCellStyle}"
                      RowStyle="{StaticResource GridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="CLIENTE / PREVENTIVO" Width="2.2*" MinWidth="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CustomerReferenceDisplay}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource DefaultTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CustomerReferenceDisplay}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="Prev. "
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding QuoteNumber}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource StatusToOrderBrush}"/>
                                        <TextBlock Text="  |  "
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding Date, StringFormat=dd/MM/yyyy}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SiteName, StringFormat='Cantiere: {0}'}"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SiteName}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SiteName}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="FORNITORE / GESTIONE" Width="1.7*" MinWidth="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource InlineTextBoxStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MaterialsOrderedByCustomer}" Value="True">
                                                        <Setter Property="IsReadOnly" Value="True"/>
                                                        <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Button Grid.Column="2"
                                            Content="&#xE721;"
                                            ToolTip="Seleziona fornitore"
                                            Click="OnSelectSupplierClick">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                <Setter Property="Width" Value="32"/>
                                                <Setter Property="MinWidth" Value="32"/>
                                                <Setter Property="Height" Value="32"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MaterialsOrderedByCustomer}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <CheckBox Grid.Row="1"
                                              Grid.ColumnSpan="3"
                                              Content="Materiali ordinati dal cliente"
                                              IsChecked="{Binding MaterialsOrderedByCustomer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="1,7,0,0"
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource DefaultTextBrush}"
                                              ToolTip="I materiali vengono ordinati direttamente dal cliente"
                                              Click="OnMaterialsOrderedByCustomerClick"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="DATA ORDINE" Width="132">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding MaterialOrderDate, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource InlineDatePickerStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="CONSEGNA PREVISTA" Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding ExpectedDeliveryDate, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource InlineDatePickerStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="STATO" Width="158">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox IsEditable="True"
                                          ItemsSource="{Binding MaterialStatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Text="{Binding MaterialStatus, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource StatusComboBoxStyle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="AZIONI" Width="138">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <Button Content="Salva"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            Background="{StaticResource DangerRedBrush}"
                                            Margin="0,0,0,6"
                                            Click="OnSaveSupplierClick"/>
                                    <Button Content="Prepara email"
                                            Style="{StaticResource RowActionButtonStyle}"
                                            Background="{StaticResource StatusUnavailableBrush}"
                                            Click="OnPrepareOrderMailClick"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border x:Name="EmptyPanel"
                    Visibility="Collapsed"
                    Background="#F7FFFFFF"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Nessun ordine trovato"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DefaultTextBrush}"/>
                    <TextBlock x:Name="TxtEmptyDetail"
                               Text="Nessun ordine corrisponde ai criteri selezionati."
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
