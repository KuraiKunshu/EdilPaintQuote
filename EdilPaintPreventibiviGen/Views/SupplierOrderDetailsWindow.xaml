<Window x:Class="EdilPaintPreventibiviGen.Views.SupplierOrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EdilPaintPreventibiviGen.Views"
        Title="Dettaglio ordine" Width="760" Height="800" MinWidth="600" MinHeight="500"
        FontSize="14" Language="it-IT" WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource ShellBackgroundBrush}" Foreground="{StaticResource DefaultTextBrush}"
        Icon="pack://application:,,,/Assets/Windowsicon/main.ico">
    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource NeutralButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,22,24,24">
                <TextBlock Text="{Binding OrderSiteTitle}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding QuoteNumber, StringFormat=Ordine {0}}" FontSize="15"
                           Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Text="{Binding OrderCustomerDetail}" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding OrderReferenceDetail}" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OrderReferenceDetail}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,18,0,0" Padding="12"
                        Background="{StaticResource WarningPanelBackgroundBrush}"
                        BorderBrush="{StaticResource WarningPanelBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <TextBlock x:Name="TxtError" TextWrapping="Wrap"/>
                </Border>

                <Border Margin="0,22,0,0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel x:Name="EditableFields">
                        <TextBlock Text="Stato materiali" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="CmbMaterialStatus" IsEditable="True" MinHeight="44" FontSize="17"
                                  Padding="8,5" Text="{Binding MaterialStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="Stato dei materiali dell’ordine"/>

                        <TextBlock Text="Fornitore" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSupplier"
                                     Text="{Binding SupplierName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding MaterialsOrderedByCustomer}"
                                     AutomationProperties.Name="Nome del fornitore"/>
                            <Button x:Name="BtnSelectSupplier" Grid.Column="1" Content="Scegli…" Margin="10,0,0,0"
                                    Click="OnSelectSupplierClick" ToolTip="Scegli un fornitore dall’anagrafica"/>
                        </Grid>
                        <CheckBox x:Name="ChkOrderedByCustomer" Margin="0,12,0,0" FontSize="14"
                                  IsChecked="{Binding MaterialsOrderedByCustomer, Mode=TwoWay}"
                                  Click="OnMaterialsOrderedByCustomerClick">
                            <TextBlock Text="Materiali ordinati direttamente dal cliente" TextWrapping="Wrap"/>
                        </CheckBox>

                        <TextBlock Text="Data ordine" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,7"/>
                        <DatePicker x:Name="OrderDate"
                                    SelectedDate="{Binding MaterialOrderDate, Mode=TwoWay}"
                                    DateValidationError="OnDateValidationError" PreviewTextInput="OnDateEdited"
                                    PreviewKeyDown="OnDateKeyDown" CalendarClosed="OnCalendarClosed"
                                    AutomationProperties.Name="Data ordine materiali"/>

                        <TextBlock Text="Consegna prevista" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,7"/>
                        <DatePicker x:Name="DeliveryDate"
                                    SelectedDate="{Binding ExpectedDeliveryDate, Mode=TwoWay}"
                                    DateValidationError="OnDateValidationError" PreviewTextInput="OnDateEdited"
                                    PreviewKeyDown="OnDateKeyDown" CalendarClosed="OnCalendarClosed"
                                    AutomationProperties.Name="Data di consegna prevista"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Documenti e azioni" Style="{StaticResource FieldLabelStyle}" Margin="0,22,0,10"/>
                <WrapPanel>
                    <views:QuoteActionsControl x:Name="CommonQuoteActions" QuoteNumber="{Binding QuoteNumber}"
                                               UseLargeButtons="True" Margin="0,0,12,8" VerticalAlignment="Top"/>
                    <Button x:Name="BtnPrepareMail" Content="Prepara email" Margin="0,0,0,8" Click="OnPrepareOrderMailClick"/>
                </WrapPanel>
                <TextBlock Text="Salva le modifiche per aggiornare l’ordine negli altri PC."
                           FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="24,14" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock x:Name="TxtBusy" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="Annulla" MinWidth="96" Margin="0,0,10,4" Click="OnCancelClick"/>
                    <Button x:Name="BtnSave" Content="Salva e chiudi" MinWidth="144" Margin="0,0,0,4"
                            Background="{StaticResource ModalPrimaryActionBrush}" Foreground="{StaticResource WhiteBrush}"
                            Click="OnSaveClick"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
