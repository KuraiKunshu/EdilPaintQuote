<Window x:Class="EdilPaintPreventibiviGen.Views.MaterialOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro ordini materiali" Width="1240" Height="780" MinWidth="850" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{StaticResource ShellBackgroundBrush}" FontSize="14" Foreground="{StaticResource DefaultTextBrush}"
        Icon="pack://application:,,,/EdilPaintPreventibiviGen;component/Assets/Windowsicon/main.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <Button x:Name="BtnRefresh" DockPanel.Dock="Right" Content="Aggiorna" Padding="16,8" VerticalAlignment="Center" Click="OnRefreshClick"/>
            <StackPanel>
                <TextBlock Text="Registro ordini materiali" FontSize="26" FontWeight="Bold" Foreground="{StaticResource DefaultTextBrush}"/>
                <TextBlock Text="Date e fornitori registrati, anche per i lavori finiti e archiviati." Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{StaticResource WhiteBrush}" Padding="14" CornerRadius="8" Margin="0,0,0,14">
            <WrapPanel>
                <StackPanel Width="250" Margin="0,0,12,6">
                    <TextBlock Text="Cliente, riferimento, cantiere o ordine" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtSearch" Height="34" Padding="8,4" TextChanged="OnFilterChanged"/>
                </StackPanel>
                <StackPanel Width="210" Margin="0,0,12,6">
                    <TextBlock Text="Fornitore" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbSupplier" Height="34" SelectionChanged="OnFilterChanged"/>
                </StackPanel>
                <StackPanel Width="145" Margin="0,0,12,6">
                    <TextBlock Text="Ordinato dal" Margin="0,0,0,6"/>
                    <DatePicker x:Name="DpFrom" Height="34" SelectedDateChanged="OnFilterChanged" DateValidationError="OnDateError"/>
                </StackPanel>
                <StackPanel Width="145" Margin="0,0,12,6">
                    <TextBlock Text="Al" Margin="0,0,0,6"/>
                    <DatePicker x:Name="DpTo" Height="34" SelectedDateChanged="OnFilterChanged" DateValidationError="OnDateError"/>
                </StackPanel>
                <Button Content="Azzera filtri" Padding="14,6" Margin="0,22,0,6" Click="OnClearFiltersClick"/>
            </WrapPanel>
        </Border>
        <DataGrid x:Name="GridOrders" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                  MinRowHeight="62" ColumnHeaderHeight="40" SelectionMode="Extended" SelectionUnit="FullRow"
                  Background="{StaticResource WhiteBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource SubtleBorderBrush}" AlternatingRowBackground="{StaticResource PanelBackgroundBrush}"
                  EnableRowVirtualization="True" ClipboardCopyMode="IncludeHeader">
            <DataGrid.Resources>
                <Style x:Key="RegisterCellStyle" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="8,6"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data ordine" Binding="{Binding OrderDateText}" Width="115" ElementStyle="{StaticResource RegisterCellStyle}"/>
                <DataGridTextColumn Header="Fornitore" Binding="{Binding Supplier}" Width="190" ElementStyle="{StaticResource RegisterCellStyle}"/>
                <DataGridTextColumn Header="Cliente · riferimento · cantiere" Binding="{Binding Job}" Width="*" MinWidth="220" ElementStyle="{StaticResource RegisterCellStyle}"/>
                <DataGridTextColumn Header="Stato materiali" Binding="{Binding MaterialStatus}" Width="125" ElementStyle="{StaticResource RegisterCellStyle}"/>
                <DataGridTextColumn Header="Consegna prevista" Binding="{Binding DeliveryText}" Width="135" ElementStyle="{StaticResource RegisterCellStyle}"/>
                <DataGridTextColumn Header="Stato lavoro" Binding="{Binding JobStatus}" Width="110" ElementStyle="{StaticResource RegisterCellStyle}"/>
                <DataGridTextColumn Header="Ordine" Binding="{Binding Number}" Width="90" ElementStyle="{StaticResource RegisterCellStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="TxtCount" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}"/>
            <TextBlock Text="Una riga per preventivo. Date e fornitore si compilano in Dettagli materiali; Non indicata significa che la data ordine non è stata registrata."
                       Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
