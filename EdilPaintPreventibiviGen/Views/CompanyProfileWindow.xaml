<Window x:Class="EdilPaintPreventibiviGen.Views.CompanyProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dati aziendali" Width="660" Height="760" MinWidth="480" MinHeight="450"
        WindowStartupLocation="CenterOwner" Background="#F3F6FA">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    </Window.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="La tua azienda" FontSize="26" FontWeight="SemiBold" Foreground="#173553"/>
            <TextBlock Text="Questi dati compariranno sui nuovi documenti generati." Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annulla" IsCancel="True"/>
            <Button x:Name="BtnSave" Content="Salva dati aziendali" Click="OnSaveClick" Background="#173553" Foreground="White"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Ragione sociale *"/><TextBox x:Name="TxtName"/>
                <TextBlock Text="Indirizzo"/><TextBox x:Name="TxtAddress"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="Partita IVA"/><TextBox x:Name="TxtVat"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Email"/><TextBox x:Name="TxtEmail"/></StackPanel>
                </Grid>
                <TextBlock Text="Condizioni di pagamento predefinite"/><TextBox x:Name="TxtPayment" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"/>
                <TextBlock Text="Ultimo numero di preventivo utilizzato"/><TextBox x:Name="TxtCounter"/>
                <TextBlock Text="Per un nuovo archivio lascia 0. La numerazione già utilizzata non può essere ridotta." TextWrapping="Wrap" Foreground="#526579" Margin="0,0,0,18"/>
                <TextBlock Text="Logo predefinito" FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbLogo" Margin="0,8" Padding="6"/>
                <WrapPanel><Button Content="Carica logo…" Click="OnLogoClick"/><Button Content="Rimuovi logo selezionato" Click="OnRemoveLogoClick"/></WrapPanel>
                <TextBlock Text="Timbro / firma aziendale" FontWeight="SemiBold" Margin="0,20,0,6"/>
                <TextBlock x:Name="TxtStamp" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <WrapPanel><Button Content="Carica immagine…" Click="OnStampClick"/><Button Content="Rimuovi" Click="OnRemoveStampClick"/></WrapPanel>
                <TextBlock Text="Immagini PNG o JPG. Logo e timbro sono conservati su questo PC: vanno caricati anche sulle altre postazioni. Il timbro viene usato nei preventivi e nel certificato di posa, se abilitato." TextWrapping="Wrap" Foreground="#526579" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
