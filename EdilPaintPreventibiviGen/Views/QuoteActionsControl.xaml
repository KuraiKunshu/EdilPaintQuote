<UserControl x:Class="EdilPaintPreventibiviGen.Views.QuoteActionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource NeutralButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
        </Style>
    </UserControl.Resources>
    <WrapPanel>
        <Button x:Name="BtnPdf" Content="PDF" MinWidth="44" Margin="0,0,4,4" Click="OnPdfClick"
                ToolTip="Apri il PDF del preventivo" AutomationProperties.Name="Apri PDF del preventivo"/>
        <Button x:Name="BtnActions" Content="Azioni ▾" MinWidth="64" Margin="0,0,0,4" Click="OnActionsClick"
                ToolTip="Azioni comuni del preventivo" AutomationProperties.Name="Azioni del preventivo"/>
    </WrapPanel>
</UserControl>
