<Window x:Class="EdilPaintPreventibiviGen.Views.PosTemplatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catalogo POS" Width="1020" Height="790" MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{StaticResource ShellBackgroundBrush}"
        Foreground="{StaticResource DefaultTextBrush}" FontSize="14" Closing="OnClosing">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="36"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,5,0,14"/><Setter Property="VerticalContentAlignment" Value="Top"/></Style>
        <Style x:Key="LongText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="AcceptsReturn" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="MinHeight" Value="90"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Catalogo POS" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Catalogo aziendale condiviso, indipendente dalle lavorazioni dei preventivi." TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock Text="Le modifiche si useranno nelle nuove schede. I POS già salvati conservano i loro testi." TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>
        <Grid Grid.Row="1" x:Name="FormPanel">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <ComboBox x:Name="CatalogKind" SelectedIndex="0" SelectionChanged="OnKindChanged" Margin="0,0,0,12"><ComboBoxItem Content="Lavorazioni"/><ComboBoxItem Content="Attrezzature"/></ComboBox>
                    <TextBlock Text="Cerca nel catalogo POS"/>
                    <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" AutomationProperties.Name="Cerca nel catalogo POS"/>
                    <WrapPanel><Button Content="Nuova scheda" Click="OnNewClick"/><Button Content="Aggiorna" Click="OnRefreshClick"/></WrapPanel>
                </StackPanel>
                <ListBox x:Name="TemplateList" SelectionChanged="OnTemplateChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" Padding="18" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="EditorPanel" IsEnabled="False">
                        <TextBlock Text="Nome della scheda (obbligatorio)"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="250"/>
                        <TextBlock Text="Categoria"/><TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Descrizione standard"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LongText}"/>
                        <StackPanel x:Name="WorkFields"><TextBlock Text="Fasi operative standard"/>
                        <TextBox Text="{Binding Phases, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LongText}"/>
                        <TextBlock Text="Attrezzature utilizzate · note"/>
                        <TextBox Text="{Binding Equipment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LongText}"/>
                        <TextBlock Text="Schede attrezzature collegate alla lavorazione"/>
                        <ListBox x:Name="EquipmentLinks" MaxHeight="180" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="4"><StackPanel><TextBlock Text="{Binding Sheet.Name}"/><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12"/></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox>
                        </StackPanel>
                        <TextBlock Text="Rischi e valutazione" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding Risks, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LongText}"/>
                        <TextBlock Text="DPI richiesti"/><TextBox Text="{Binding Dpi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LongText}"/>
                        <TextBlock x:Name="ProceduresLabel" Text="Procedure operative" TextWrapping="Wrap"/><TextBox Text="{Binding Procedures, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LongText}"/>
                        <TextBlock Text="Misure preventive e protettive"/><TextBox Text="{Binding Measures, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LongText}"/>
                        <StackPanel x:Name="WorkOrganization"><TextBlock Text="Scelte progettuali e organizzative"/><TextBox Text="{Binding Organization, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LongText}"/>
                        <TextBlock Text="Misure di coordinamento"/><TextBox Text="{Binding Coordination, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LongText}"/></StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ArchiveButton" Content="Archivia modello" Click="OnArchiveClick" IsEnabled="False"/>
                <Button x:Name="SaveButton" Content="Salva testo standard" Click="OnSaveClick" IsEnabled="False" Background="{StaticResource ModalPrimaryActionBrush}" Foreground="{StaticResource WhiteBrush}"/>
                <Button Content="Chiudi" Click="OnCloseClick"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="Aggiungi i tuoi testi standard oppure scegli un modello da modificare." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
