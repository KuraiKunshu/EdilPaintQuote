<Window x:Class="EdilPaintPreventibiviGen.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Impostazioni"
        Width="1000"
        Height="780"
        MinWidth="900"
        MinHeight="640"
        MaxWidth="1200"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="{StaticResource TransparentBrush}"
        Icon="pack://application:,,,/Assets/Windowsicon/main.png">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            CornerRadius="0"
                            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource HoverSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ModalPrimaryActionBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalPrimaryActionBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource NeutralButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource NeutralButtonBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource NeutralButtonTextBrush}"/>
        </Style>

        <Style x:Key="CompactActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource SecondaryBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SecondaryBlueBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
        </Style>

        <Style x:Key="DangerCompactButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CompactActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerSoftBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerSoftBorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerRedBrush}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlueBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="{StaticResource WhiteBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ModalFieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
        </Style>

        <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource DefaultTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{StaticResource HoverSurfaceBrush}"/>
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource SubtleBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryBlueBrush}"/>
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource PrimaryBlueBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsTabItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="5">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <Border Grid.Row="2"
                                    Background="{StaticResource ShellBackgroundBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource TransparentBrush}"
          KeyboardNavigation.TabNavigation="Cycle">
        <Border Background="{StaticResource SurfaceBrush}"
                CornerRadius="12"
                BorderBrush="{StaticResource WindowShadowBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.22"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="68"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="20,0,10,0"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Background="{StaticResource SectionPanelBackgroundBrush}"
                            BorderBrush="{StaticResource PrimaryBlueBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <TextBlock Text="⚙"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="21"
                                   Foreground="{StaticResource PrimaryBlueBrush}"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Impostazioni applicazione"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DefaultTextBrush}"/>
                        <TextBlock Text="Configura funzioni, collegamenti e preferenze di questo PC"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Style="{StaticResource HeaderButtonStyle}"
                            Content="X"
                            ToolTip="Chiudi"
                            Click="OnCancelClick"/>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource SubtleBorderBrush}"/>

                <Grid Grid.Row="2" Background="{StaticResource ShellBackgroundBrush}">
                    <TabControl x:Name="SettingsTabs"
                                Margin="20,16"
                                SelectedIndex="0"
                                Style="{StaticResource SettingsTabControlStyle}">
                        <TabItem x:Name="TabGeneralSettings" Header="_Generali">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          HorizontalContentAlignment="Stretch"
                                          Focusable="False">
                                <StackPanel Margin="18,16,18,6" HorizontalAlignment="Stretch">
                                    <StackPanel Margin="2,0,0,14">
                                        <TextBlock Text="Preferenze generali"
                                                   Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="Comportamento dell'app, valori iniziali e manutenzione locale."
                                                   Style="{StaticResource PageSubtitleStyle}"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <Border Style="{StaticResource SectionStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Comportamento"
                                                               Style="{StaticResource SectionTitleStyle}"/>
                                                    <CheckBox x:Name="ChkGeneratePdf"
                                                              Content="Abilita generazione PDF"
                                                              Margin="0,0,0,10"/>
                                                    <CheckBox x:Name="ChkRestoreMissingPdfsOnStartup"
                                                              Content="Ripristina automaticamente i PDF mancanti all'avvio"
                                                              Margin="0,0,0,10"/>
                                                    <CheckBox x:Name="ChkDatabaseCostSavingMode"
                                                              Content="Modalità risparmio database"
                                                              Margin="0,0,0,10"/>
                                                    <CheckBox x:Name="ChkSilentStartup"
                                                              Content="Chiudi silenziosamente in caso di errore all'avvio"/>
                                                    <TextBlock Style="{StaticResource HintStyle}"
                                                               Text="La modalità risparmio disattiva la sincronizzazione automatica ogni 5 minuti dal prossimo avvio."/>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource SectionStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Aggiornamenti"
                                                                   Style="{StaticResource SectionTitleStyle}"/>
                                                        <TextBlock Style="{StaticResource HintStyle}"
                                                                   Margin="0"
                                                                   Text="Avvia lo script updater configurato. L'app verrà chiusa durante la sostituzione dei file."/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="Aggiorna ora"
                                                            Margin="14,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource CompactActionButtonStyle}"
                                                            Click="OnRunUpdaterClick"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <Border Style="{StaticResource SectionStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Calcolo guadagno reale"
                                                               Style="{StaticResource SectionTitleStyle}"/>
                                                    <TextBlock Style="{StaticResource HintStyle}"
                                                               Margin="0,0,0,12"
                                                               Text="Valori proposti all'apertura del calcolo, sempre modificabili sul singolo preventivo."/>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource LabelStyle}" Text="Numero operai"/>
                                                            <TextBox x:Name="TxtDefaultProfitWorkers"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Style="{StaticResource LabelStyle}" Text="Numero giorni"/>
                                                            <TextBox x:Name="TxtDefaultProfitDays"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Margin="0,12,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource LabelStyle}" Text="Ore al giorno"/>
                                                            <TextBox x:Name="TxtDefaultProfitHoursPerDay"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Style="{StaticResource LabelStyle}" Text="Costo orario (€)"/>
                                                            <TextBox x:Name="TxtDefaultProfitHourlyCost"/>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Style="{StaticResource LabelStyle}"
                                                               Text="Riduzione prudenziale utile (%)"
                                                               Margin="0,12,0,6"/>
                                                    <TextBox x:Name="TxtDefaultProfitReductionPercentage"/>
                                                    <TextBlock Style="{StaticResource HintStyle}"
                                                               Text="Riduce soltanto gli utili positivi. Con 10%, un utile calcolato di 1.000 € diventa 900 €."/>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource SectionStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Avanzate"
                                                               Style="{StaticResource SectionTitleStyle}"/>
                                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Cartella temporanea"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="TxtTempPath"/>
                                                        <Button Grid.Column="2"
                                                                Content="Sfoglia"
                                                                Style="{StaticResource CompactActionButtonStyle}"
                                                                Click="OnBrowseTempPathClick"/>
                                                    </Grid>
                                                    <TextBlock Style="{StaticResource HintStyle}"
                                                               Text="Se vuota, viene usata la cartella temporanea di Windows."/>

                                                    <TextBlock Style="{StaticResource LabelStyle}"
                                                               Text="Nome dispositivo"
                                                               Margin="0,12,0,6"/>
                                                    <TextBox x:Name="TxtDeviceName"/>
                                                    <TextBlock Style="{StaticResource HintStyle}"
                                                               Text="Nome usato nei log, nello storico e nella sincronizzazione multi PC."/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource SectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Materiali automatici"
                                                       Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Style="{StaticResource HintStyle}"
                                                       Margin="0,0,0,12"
                                                       Text="Quando una lavorazione configurata è presente, il Guadagno reale aggiunge i materiali selezionati ai costi aziendali. Ogni regola può usare le misure delle finestre oppure la sola quantità della lavorazione."/>

                                            <Border x:Name="BorderWindowMaterialCatalogIdentityWarning"
                                                    Background="{StaticResource DangerSoftBackgroundBrush}"
                                                    BorderBrush="{StaticResource DangerSoftBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="12,9"
                                                    Margin="0,0,0,12"
                                                    Visibility="Collapsed">
                                                <TextBlock x:Name="TxtWindowMaterialCatalogIdentityWarning"
                                                           Foreground="{StaticResource DangerRedBrush}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                            </Border>

                                            <Border Background="{StaticResource WhiteBrush}"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="12"
                                                    Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource LabelStyle}"
                                                               Text="Prefissi prodotti finestra"/>
                                                    <TextBox x:Name="TxtWindowProductPrefixes"
                                                             Height="82"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             VerticalContentAlignment="Top"
                                                             VerticalScrollBarVisibility="Auto"/>
                                                    <TextBlock Style="{StaticResource HintStyle}"
                                                               Text="Uno per riga. Il nome prodotto deve iniziare con uno di questi codici, ad esempio GGL, Q4 o R8. Se la lista è vuota vengono ripristinati i valori predefiniti."/>
                                                </StackPanel>
                                            </Border>

                                            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                                <Button DockPanel.Dock="Right"
                                                        Content="+ Aggiungi regola"
                                                        Style="{StaticResource CompactActionButtonStyle}"
                                                        Click="OnAddWindowMaterialRuleClick"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Regole materiali"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource DefaultTextBrush}"/>
                                                    <TextBlock Style="{StaticResource HintStyle}"
                                                               Margin="0,2,12,0"
                                                               Text="Ogni regola collega una lavorazione a uno specifico materiale aziendale."/>
                                                </StackPanel>
                                            </DockPanel>

                                            <TextBlock x:Name="TxtNoCompanyMaterials"
                                                       Foreground="{StaticResource DangerRedBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8"
                                                       Visibility="Collapsed"
                                                       Text="Non ci sono materiali aziendali selezionabili. Contrassegna prima almeno un materiale come materiale aziendale."/>

                                            <TextBlock x:Name="TxtNoWindowMaterialRules"
                                                       Style="{StaticResource HintStyle}"
                                                       Margin="0,4,0,8"
                                                       Visibility="Collapsed"
                                                       Text="Nessuna regola configurata. Il calcolo non aggiungerà materiali automatici."/>

                                            <ItemsControl x:Name="ItemsWindowMaterialRules">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource WhiteBrush}"
                                                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="7"
                                                                Padding="12"
                                                                Margin="0,0,0,9">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="30"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox Grid.Column="0"
                                                                          Content="Attiva"
                                                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,17,14,0"/>

                                                                <StackPanel Grid.Column="1" IsEnabled="{Binding Enabled}">
                                                                    <TextBlock Style="{StaticResource LabelStyle}"
                                                                               Text="Se è presente la lavorazione"/>
                                                                    <ComboBox ItemsSource="{Binding LaborCatalog, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                              IsEditable="True"
                                                                              IsTextSearchEnabled="True"
                                                                              TextSearch.TextPath="Name"
                                                                              StaysOpenOnEdit="True"
                                                                              SelectedItem="{Binding SelectedLabor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              Text="{Binding LaborName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid MinWidth="280">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Text="{Binding Name}"
                                                                                               TextTrimming="CharacterEllipsis"/>
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding PersistentId, StringFormat=ID {0}}"
                                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                                               Margin="12,0,0,0"/>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <TextBlock Style="{StaticResource HintStyle}"
                                                                               Text="{Binding LaborCatalogInfo}"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="→"
                                                                           FontSize="18"
                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,17,0,0"/>

                                                                <StackPanel Grid.Column="3" IsEnabled="{Binding Enabled}">
                                                                    <TextBlock Style="{StaticResource LabelStyle}"
                                                                               Text="Aggiungi il materiale aziendale"/>
                                                                    <ComboBox ItemsSource="{Binding CompanyMaterialCatalog, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                              IsEditable="True"
                                                                              IsTextSearchEnabled="True"
                                                                              TextSearch.TextPath="Name"
                                                                              StaysOpenOnEdit="True"
                                                                              SelectedItem="{Binding SelectedMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              Text="{Binding MaterialName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid MinWidth="320">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Text="{Binding Name}"
                                                                                               TextTrimming="CharacterEllipsis"/>
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding PersistentId, StringFormat=ID {0}}"
                                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                                               Margin="12,0,0,0"/>
                                                                                    <TextBlock Grid.Column="2"
                                                                                               Text="{Binding UnitPrice, StringFormat={}{0:N2} €}"
                                                                                               Foreground="{StaticResource MutedTextBrush}"
                                                                                               Margin="12,0,0,0"/>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <TextBlock Style="{StaticResource HintStyle}"
                                                                               Text="{Binding MaterialCatalogInfo}"/>
                                                                </StackPanel>

                                                                <Button Grid.Column="4"
                                                                        Content="×"
                                                                        Width="34"
                                                                        MinWidth="34"
                                                                        Height="34"
                                                                        Padding="0"
                                                                        Margin="12,18,0,0"
                                                                        VerticalAlignment="Top"
                                                                        ToolTip="Rimuovi regola"
                                                                        Style="{StaticResource DangerCompactButtonStyle}"
                                                                        Click="OnRemoveWindowMaterialRuleClick"/>

                                                                <Grid Grid.Row="1"
                                                                      Grid.Column="1"
                                                                      Grid.ColumnSpan="3"
                                                                      Margin="0,12,0,0"
                                                                      IsEnabled="{Binding Enabled}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="190"/>
                                                                        <ColumnDefinition Width="12"/>
                                                                        <ColumnDefinition Width="220"/>
                                                                        <ColumnDefinition Width="12"/>
                                                                        <ColumnDefinition Width="150"/>
                                                                        <ColumnDefinition Width="12"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Content="Automazione per finestra"
                                                                              IsChecked="{Binding IsWindowAutomation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,20,0,0"
                                                                              ToolTip="Se attiva usa misure e quantità delle finestre; altrimenti usa solo la quantità della lavorazione."/>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Style="{StaticResource LabelStyle}"
                                                                                   Text="Tipo di calcolo"/>
                                                                        <ComboBox ItemsSource="{Binding WindowMaterialCalculationModes, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                                  DisplayMemberPath="Label"
                                                                                  SelectedValuePath="Value"
                                                                                  IsEnabled="{Binding IsWindowAutomation}"
                                                                                  SelectedValue="{Binding CalculationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="4">
                                                                        <TextBlock Style="{StaticResource LabelStyle}"
                                                                                   Text="Parametro quantità"/>
                                                                        <TextBox Text="{Binding QuantityParameterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="6"
                                                                               Style="{StaticResource HintStyle}"
                                                                               Margin="0,22,0,0"
                                                                               VerticalAlignment="Center"
                                                                               Text="{Binding CalculationHint}"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="TabDatabaseSettings" Header="_Database e integrazioni">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          HorizontalContentAlignment="Stretch"
                                          Focusable="False">
                                <StackPanel Margin="18,16,18,6" HorizontalAlignment="Stretch">
                                    <StackPanel Margin="2,0,0,14">
                                        <TextBlock Text="Database e integrazioni"
                                                   Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="Connessione ai dati condivisi e servizi esterni utilizzati dall'app."
                                                   Style="{StaticResource PageSubtitleStyle}"/>
                                    </StackPanel>

                                    <Border Style="{StaticResource SectionStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Connessione database"
                                                       Style="{StaticResource SectionTitleStyle}"/>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="130"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Tipo database"/>
                                                    <ComboBox x:Name="CmbDatabaseProvider"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Porta"/>
                                                    <TextBox x:Name="TxtDatabasePort"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Server / host"/>
                                                    <TextBox x:Name="TxtDatabaseServer"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Database"/>
                                                    <TextBox x:Name="TxtDatabaseName"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Utente"/>
                                                    <TextBox x:Name="TxtDatabaseUsername"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Password"/>
                                                    <PasswordBox x:Name="TxtDatabasePassword"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Style="{StaticResource HintStyle}"
                                                       Text="Per Neon/PostgreSQL usa normalmente la porta 5432. Le credenziali vengono salvate cifrate per questo utente Windows."/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SectionStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Integrazione Velux"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <CheckBox x:Name="ChkUseVeluxLogin"
                                                          Content="Cerca anche nel catalogo Velux durante la ricerca materiali"/>
                                                <TextBlock Style="{StaticResource HintStyle}"
                                                           Text="Il login avviene nel browser integrato e la sessione resta salvata solo su questo PC."/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Rimuovi sessione"
                                                    Margin="16,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource DangerCompactButtonStyle}"
                                                    Click="OnClearVeluxSessionClick"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="TabEmailSettings" Header="_Email">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          HorizontalContentAlignment="Stretch"
                                          Focusable="False">
                                <StackPanel Margin="18,16,18,6" HorizontalAlignment="Stretch">
                                    <StackPanel Margin="2,0,0,14">
                                        <TextBlock Text="Configurazione email"
                                                   Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="Invio dei preventivi e composizione degli ordini destinati ai fornitori."
                                                   Style="{StaticResource PageSubtitleStyle}"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource SectionStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Invio preventivi"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <CheckBox x:Name="ChkMailEnabled"
                                                          Content="Abilita invio email via SMTP"
                                                          Margin="0,0,0,12"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="92"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Server SMTP"/>
                                                        <TextBox x:Name="TxtMailSmtpServer"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Porta"/>
                                                        <TextBox x:Name="TxtMailPort"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="4"
                                                              x:Name="ChkMailUseSsl"
                                                              Content="SSL/TLS"
                                                              VerticalAlignment="Bottom"
                                                              Margin="0,0,0,10"/>
                                                </Grid>

                                                <TextBlock Style="{StaticResource LabelStyle}"
                                                           Text="Utente / email"
                                                           Margin="0,12,0,6"/>
                                                <TextBox x:Name="TxtMailUsername"/>

                                                <TextBlock Style="{StaticResource LabelStyle}"
                                                           Text="Password"
                                                           Margin="0,12,0,6"/>
                                                <PasswordBox x:Name="TxtMailPassword"/>

                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Email mittente"/>
                                                        <TextBox x:Name="TxtMailSenderEmail"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Nome mittente"/>
                                                        <TextBox x:Name="TxtMailSenderName"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Style="{StaticResource LabelStyle}"
                                                           Text="Oggetto predefinito"
                                                           Margin="0,12,0,6"/>
                                                <TextBox x:Name="TxtMailSubject"/>

                                                <TextBlock Style="{StaticResource LabelStyle}"
                                                           Text="Testo predefinito"
                                                           Margin="0,12,0,6"/>
                                                <TextBox x:Name="TxtMailBody"
                                                         Height="94"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalContentAlignment="Top"
                                                         VerticalScrollBarVisibility="Auto"/>
                                                <TextBlock Style="{StaticResource HintStyle}"
                                                           Text="Per Libero: smtp.libero.it, porta 465, SSL/TLS. Variabili: {QuoteNumber}, {CustomerName}, {ReferenceName}, {Date}, {Total}."/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource SectionStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Ordini fornitori"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Style="{StaticResource HintStyle}"
                                                           Margin="0,0,0,12"
                                                           Text="Personalizza liberamente oggetto e testo usando le variabili tra parentesi graffe."/>

                                                <TextBlock Style="{StaticResource LabelStyle}"
                                                           Text="Oggetto personalizzato"/>
                                                <TextBox x:Name="TxtSupplierOrderMailSubject"/>

                                                <TextBlock Style="{StaticResource LabelStyle}"
                                                           Text="Testo personalizzato"
                                                           Margin="0,12,0,6"/>
                                                <TextBox x:Name="TxtSupplierOrderMailBody"
                                                         Height="150"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalContentAlignment="Top"
                                                         VerticalScrollBarVisibility="Auto"/>
                                                <TextBlock Style="{StaticResource HintStyle}"
                                                           Text="Variabili: {OrderReference}, {QuoteNumber}, {CustomerName}, {ReferenceName}, {SupplierName}, {Date}, {Materials}. La variabile {Materials} è obbligatoria."/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="TabPdfSettings" Header="_PDF e archiviazione">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          HorizontalContentAlignment="Stretch"
                                          Focusable="False">
                                <StackPanel Margin="18,16,18,6" HorizontalAlignment="Stretch">
                                    <StackPanel Margin="2,0,0,14">
                                        <TextBlock Text="PDF e storico"
                                                   Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="Percorsi di archiviazione, nomi file e aspetto dei preventivi generati."
                                                   Style="{StaticResource PageSubtitleStyle}"/>
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource SectionStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Archiviazione PDF"
                                                           Style="{StaticResource SectionTitleStyle}"/>

                                                <TextBlock Style="{StaticResource LabelStyle}" Text="Cartella principale PDF"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TxtPdfRootPath"/>
                                                    <Button Grid.Column="2"
                                                            Content="Sfoglia"
                                                            Style="{StaticResource CompactActionButtonStyle}"
                                                            Click="OnBrowsePdfRootClick"/>
                                                </Grid>

                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Sottocartella storico"/>
                                                        <TextBox x:Name="TxtHistorySubFolder"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Risultati nello storico"/>
                                                        <TextBox x:Name="TxtHistoryResultLimit"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Style="{StaticResource LabelStyle}"
                                                           Text="Formato cartella cliente"
                                                           Margin="0,12,0,6"/>
                                                <TextBox x:Name="TxtCustomerFolderPattern"/>
                                                <TextBlock Style="{StaticResource HintStyle}"
                                                           Text="Variabili: {CustomerName}, {ReferenceName}"/>

                                                <TextBlock Style="{StaticResource LabelStyle}"
                                                           Text="Formato nome PDF"
                                                           Margin="0,12,0,6"/>
                                                <TextBox x:Name="TxtPdfFileNamePattern"/>
                                                <TextBlock Style="{StaticResource HintStyle}"
                                                           Text="Variabili: {CustomerName}, {ReferenceName}, {QuoteNumber}, {Date}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource SectionStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Template PDF"
                                                           Style="{StaticResource SectionTitleStyle}"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Template attivo"/>
                                                        <ComboBox x:Name="CmbPdfTemplate"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Firma"/>
                                                        <TextBox x:Name="TxtPdfSignatureText"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Style="{StaticResource LabelStyle}"
                                                           Text="Titolo sezione NOTE"
                                                           Margin="0,12,0,6"/>
                                                <TextBox x:Name="TxtPdfNotesTitle"/>

                                                <TextBlock Style="{StaticResource LabelStyle}"
                                                           Text="Footer PDF"
                                                           Margin="0,12,0,6"/>
                                                <TextBox x:Name="TxtPdfFooterText"
                                                         Height="72"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalContentAlignment="Top"
                                                         VerticalScrollBarVisibility="Auto"/>
                                                <CheckBox x:Name="ChkPdfShowTemplateName"
                                                          Content="Mostra il nome del template nel PDF"
                                                          Margin="0,12,0,0"/>
                                                <Button Content="Anteprima template"
                                                        Margin="0,14,0,0"
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource CompactActionButtonStyle}"
                                                        Click="OnPreviewPdfTemplateClick"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

                <Border Grid.Row="3" Background="{StaticResource SubtleBorderBrush}"/>

                <Border Grid.Row="4"
                        Background="{StaticResource SurfaceBrush}"
                        Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="Le modifiche vengono applicate dopo il salvataggio."
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Annulla"
                                    Width="110"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="OnCancelClick"/>
                            <Button Content="Salva"
                                    Width="118"
                                    Margin="10,0,0,0"
                                    IsDefault="True"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Click="OnSaveClick"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
