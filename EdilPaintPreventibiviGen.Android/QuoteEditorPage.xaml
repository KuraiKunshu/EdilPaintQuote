<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EdilPaintPreventibiviGen.Android.QuoteEditorPage"
             BackgroundColor="#F8F3F1"
             Title="Preventivo">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16"
                                 Spacing="16">
                <Border StrokeThickness="0"
                        BackgroundColor="#B3261E"
                        Padding="16"
                        StrokeShape="RoundRectangle 8">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="HeaderTitleLabel"
                                   Text="Nuovo preventivo"
                                   FontSize="23"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"/>
                            <Label Text="Numero"
                                   FontSize="11"
                                   TextColor="#F6C7C0"/>
                            <Label x:Name="QuoteNumberLabel"
                                   Text="Assegnato al salvataggio"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                StrokeThickness="0"
                                BackgroundColor="#7F1D1D"
                                Padding="10,5"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                StrokeShape="RoundRectangle 6">
                            <Label x:Name="ModeLabel"
                                   Text="BOZZA"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF"/>
                        </Border>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Dati principali"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#221614"/>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Cliente *"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#7B6661"/>
                            <Border Stroke="#E6D6D2"
                                    BackgroundColor="#FFFFFF"
                                    Padding="8,0"
                                    StrokeShape="RoundRectangle 8">
                                <Picker x:Name="CustomerPicker"
                                        Title="Seleziona cliente"
                                        SelectedIndexChanged="OnCustomerChanged"/>
                            </Border>
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="+"
                                Clicked="OnCreateCustomerClicked"
                                BackgroundColor="#FFFFFF"
                                BorderColor="#B3261E"
                                BorderWidth="1"
                                TextColor="#B3261E"
                                FontSize="22"
                                Padding="0"
                                WidthRequest="48"
                                HeightRequest="48"
                                VerticalOptions="End"
                                CornerRadius="8"/>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Cantiere"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#7B6661"/>
                        <Border Stroke="#E6D6D2"
                                BackgroundColor="#FFFFFF"
                                Padding="10,1"
                                StrokeShape="RoundRectangle 8">
                            <Entry x:Name="SiteNameEntry"
                                   Placeholder="Nome o indirizzo del cantiere"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Riferimento"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#7B6661"/>
                        <Border Stroke="#E6D6D2"
                                BackgroundColor="#FFFFFF"
                                Padding="8,0"
                                StrokeShape="RoundRectangle 8">
                            <Picker x:Name="ReferencePicker"
                                    Title="Nessun riferimento"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Intestatario fattura"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#7B6661"/>
                        <Border Stroke="#E6D6D2"
                                BackgroundColor="#FFFFFF"
                                Padding="8,0"
                                StrokeShape="RoundRectangle 8">
                            <Picker x:Name="BillingCustomerPicker"
                                    Title="Nessun intestatario separato"/>
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Data"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#7B6661"/>
                            <Border Stroke="#E6D6D2"
                                    BackgroundColor="#FFFFFF"
                                    Padding="8,0"
                                    StrokeShape="RoundRectangle 8">
                                <DatePicker x:Name="QuoteDatePicker"
                                            Format="dd/MM/yyyy"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="6">
                            <Label Text="Stato"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#7B6661"/>
                            <Border Stroke="#E6D6D2"
                                    BackgroundColor="#FFFFFF"
                                    Padding="8,0"
                                    StrokeShape="RoundRectangle 8">
                                <Picker x:Name="QuoteStatusPicker"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <BoxView HeightRequest="1"
                         BackgroundColor="#E6D6D2"/>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Materiali"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#221614"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                Text="+ Materiale"
                                Clicked="OnAddMaterialClicked"
                                BackgroundColor="#FFFFFF"
                                BorderColor="#B3261E"
                                BorderWidth="1"
                                TextColor="#B3261E"
                                Padding="12,7"
                                CornerRadius="8"/>
                    </Grid>
                    <Label x:Name="NoMaterialsLabel"
                           Text="Nessun materiale inserito"
                           FontSize="13"
                           TextColor="#7B6661"/>
                    <VerticalStackLayout x:Name="MaterialsList"
                                         Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#E6D6D2"
                                        BackgroundColor="#FFFFFF"
                                        Padding="12"
                                        StrokeShape="RoundRectangle 8">
                                    <Grid RowDefinitions="Auto,Auto,Auto"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10"
                                          RowSpacing="5">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#221614"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding TotalDisplay}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#B3261E"/>
                                        <Label Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding DetailDisplay}"
                                               FontSize="12"
                                               TextColor="#7B6661"/>
                                        <Grid Grid.Row="2"
                                              Grid.ColumnSpan="2"
                                              ColumnDefinitions="*,Auto,Auto"
                                              ColumnSpacing="6">
                                            <Label Text="{Binding DescriptionDisplay}"
                                                   FontSize="12"
                                                   TextColor="#7B6661"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center"/>
                                            <Button Grid.Column="1"
                                                    Text="Modifica"
                                                    Clicked="OnEditMaterialClicked"
                                                    BackgroundColor="#FCEDEA"
                                                    TextColor="#B3261E"
                                                    Padding="9,5"
                                                    HeightRequest="36"/>
                                            <Button Grid.Column="2"
                                                    Text="Rimuovi"
                                                    Clicked="OnRemoveMaterialClicked"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#7B6661"
                                                    Padding="9,5"
                                                    HeightRequest="36"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <BoxView HeightRequest="1"
                         BackgroundColor="#E6D6D2"/>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Lavorazioni"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#221614"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                Text="+ Lavorazione"
                                Clicked="OnAddLaborClicked"
                                BackgroundColor="#FFFFFF"
                                BorderColor="#B3261E"
                                BorderWidth="1"
                                TextColor="#B3261E"
                                Padding="12,7"
                                CornerRadius="8"/>
                    </Grid>
                    <Label x:Name="NoLaborsLabel"
                           Text="Nessuna lavorazione inserita"
                           FontSize="13"
                           TextColor="#7B6661"/>
                    <VerticalStackLayout x:Name="LaborsList"
                                         Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#E6D6D2"
                                        BackgroundColor="#FFFFFF"
                                        Padding="12"
                                        StrokeShape="RoundRectangle 8">
                                    <Grid RowDefinitions="Auto,Auto,Auto"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10"
                                          RowSpacing="5">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#221614"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding TotalDisplay}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#B3261E"/>
                                        <Label Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding DetailDisplay}"
                                               FontSize="12"
                                               TextColor="#7B6661"/>
                                        <Grid Grid.Row="2"
                                              Grid.ColumnSpan="2"
                                              ColumnDefinitions="*,Auto,Auto"
                                              ColumnSpacing="6">
                                            <Label Text="{Binding DescriptionDisplay}"
                                                   FontSize="12"
                                                   TextColor="#7B6661"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center"/>
                                            <Button Grid.Column="1"
                                                    Text="Modifica"
                                                    Clicked="OnEditLaborClicked"
                                                    BackgroundColor="#FCEDEA"
                                                    TextColor="#B3261E"
                                                    Padding="9,5"
                                                    HeightRequest="36"/>
                                            <Button Grid.Column="2"
                                                    Text="Rimuovi"
                                                    Clicked="OnRemoveLaborClicked"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#7B6661"
                                                    Padding="9,5"
                                                    HeightRequest="36"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <BoxView HeightRequest="1"
                         BackgroundColor="#E6D6D2"/>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Condizioni economiche"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#221614"/>
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Sconto materiali (%)"
                                   FontSize="12"
                                   TextColor="#7B6661"/>
                            <Entry x:Name="MaterialDiscountEntry"
                                   Text="0"
                                   Keyboard="Numeric"
                                   TextChanged="OnTotalsInputChanged"
                                   BackgroundColor="#FFFFFF"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="6">
                            <Label Text="Sconto lavorazioni (%)"
                                   FontSize="12"
                                   TextColor="#7B6661"/>
                            <Entry x:Name="LaborDiscountEntry"
                                   Text="0"
                                   Keyboard="Numeric"
                                   TextChanged="OnTotalsInputChanged"
                                   BackgroundColor="#FFFFFF"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Row="1"
                                             Grid.ColumnSpan="2"
                                             Spacing="6">
                            <Label Text="IVA"
                                   FontSize="12"
                                   TextColor="#7B6661"/>
                            <Border Stroke="#E6D6D2"
                                    BackgroundColor="#FFFFFF"
                                    Padding="8,0"
                                    StrokeShape="RoundRectangle 8">
                                <Picker x:Name="IvaPicker"
                                        SelectedIndexChanged="OnTotalsInputChanged"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Termini di pagamento"
                               FontSize="12"
                               TextColor="#7B6661"/>
                        <Border Stroke="#E6D6D2"
                                BackgroundColor="#FFFFFF"
                                Padding="10,5"
                                StrokeShape="RoundRectangle 8">
                            <Editor x:Name="PaymentTermsEditor"
                                    Placeholder="Modalità e scadenze di pagamento"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="72"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Note per il cliente"
                               FontSize="12"
                               TextColor="#7B6661"/>
                        <Border Stroke="#E6D6D2"
                                BackgroundColor="#FFFFFF"
                                Padding="10,5"
                                StrokeShape="RoundRectangle 8">
                            <Editor x:Name="CustomerNotesEditor"
                                    Placeholder="Note visibili nel preventivo"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="82"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Note interne"
                               FontSize="12"
                               TextColor="#7B6661"/>
                        <Border Stroke="#E6D6D2"
                                BackgroundColor="#FFFFFF"
                                Padding="10,5"
                                StrokeShape="RoundRectangle 8">
                            <Editor x:Name="InternalNotesEditor"
                                    Placeholder="Annotazioni interne"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="82"/>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Border Stroke="#E7B8B2"
                        BackgroundColor="#FCEDEA"
                        Padding="14"
                        StrokeShape="RoundRectangle 8">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto"
                          RowSpacing="5">
                        <Label Text="Imponibile"
                               FontSize="13"
                               TextColor="#7B6661"/>
                        <Label x:Name="TaxableLabel"
                               Grid.Column="1"
                               Text="0,00 €"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#221614"/>
                        <Label Grid.Row="1"
                               Text="IVA"
                               FontSize="13"
                               TextColor="#7B6661"/>
                        <Label x:Name="VatLabel"
                               Grid.Row="1"
                               Grid.Column="1"
                               Text="0,00 €"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#221614"/>
                        <Label Grid.Row="2"
                               Text="Totale preventivo"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#B3261E"/>
                        <Label x:Name="GrandTotalLabel"
                               Grid.Row="2"
                               Grid.Column="1"
                               Text="0,00 €"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#B3261E"/>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1"
                Stroke="#E6D6D2"
                StrokeThickness="1"
                BackgroundColor="#FFFFFF"
                Padding="16,12">
            <Button x:Name="SaveButton"
                    Text="Salva preventivo"
                    Clicked="OnSaveClicked"
                    BackgroundColor="#B3261E"
                    TextColor="#FFFFFF"
                    CornerRadius="8"
                    HeightRequest="52"/>
        </Border>

        <ActivityIndicator x:Name="Busy"
                           Grid.RowSpan="2"
                           IsVisible="False"
                           IsRunning="False"
                           Color="#B3261E"
                           WidthRequest="48"
                           HeightRequest="48"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
    </Grid>
</ContentPage>
