<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EdilPaintPreventibiviGen.Android.MainPage"
             BackgroundColor="#F8F3F1"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="16,18,16,12"
          RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <VerticalStackLayout Spacing="1">
                <Label Text="EdilPaint"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#B3261E"/>
                <Label x:Name="PageTitleLabel"
                       Text="Preventivi"
                       FontSize="29"
                       FontAttributes="Bold"
                       TextColor="#221614"/>
                <Label x:Name="SubtitleLabel"
                       Text="Connessione a Neon"
                       FontSize="13"
                       TextColor="#7B6661"/>
            </VerticalStackLayout>

            <Button x:Name="ForgetButton"
                    Grid.Column="1"
                    Text="Esci"
                    IsVisible="False"
                    Clicked="OnForgetCredentialsClicked"
                    BackgroundColor="#FFFFFF"
                    BorderColor="#E6D6D2"
                    BorderWidth="1"
                    TextColor="#B3261E"
                    CornerRadius="8"
                    Padding="12,8"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    WidthRequest="72"
                    HeightRequest="46"/>
        </Grid>

        <Border x:Name="SectionBar"
                Grid.Row="1"
                IsVisible="False"
                Stroke="#E6D6D2"
                StrokeThickness="1"
                BackgroundColor="#FFFFFF"
                Padding="4"
                StrokeShape="RoundRectangle 8">
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="4">
                <Button x:Name="QuotesSectionButton"
                        Text="Preventivi"
                        Clicked="OnQuotesSectionClicked"
                        CornerRadius="6"
                        HeightRequest="44"/>
                <Button x:Name="CustomersSectionButton"
                        Grid.Column="1"
                        Text="Clienti"
                        Clicked="OnCustomersSectionClicked"
                        CornerRadius="6"
                        HeightRequest="44"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ScrollView x:Name="SetupPanel">
                <VerticalStackLayout Spacing="14">
                    <Border Stroke="#E6D6D2"
                            StrokeThickness="1"
                            BackgroundColor="#FFFFFF"
                            Padding="16"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Accesso Neon"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#221614"/>
                            <Label Text="La connection string viene protetta dal Keystore Android."
                                   FontSize="13"
                                   TextColor="#7B6661"/>
                            <Entry x:Name="ConnectionStringEntry"
                                   Placeholder="postgresql://utente:password@host/neondb?sslmode=require"
                                   Keyboard="Url"
                                   IsPassword="True"
                                   ClearButtonVisibility="WhileEditing"
                                   TextColor="#221614"/>
                            <Button Text="Salva e accedi"
                                    Clicked="OnSaveCredentialsClicked"
                                    BackgroundColor="#B3261E"
                                    TextColor="#FFFFFF"
                                    CornerRadius="8"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <Grid x:Name="QuotesPanel"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,Auto,*"
                  RowSpacing="10">
                <SearchBar x:Name="QuoteSearchBox"
                           Placeholder="Cerca cliente, cantiere o numero"
                           SearchButtonPressed="OnQuoteSearchRequested"
                           TextChanged="OnQuoteSearchTextChanged"
                           BackgroundColor="#FFFFFF"
                           TextColor="#221614"
                           PlaceholderColor="#7B6661"/>

                <Grid Grid.Row="1"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                    <Picker x:Name="StatusPicker"
                            Title="Tutti gli stati"
                            SelectedIndexChanged="OnStatusChanged"
                            BackgroundColor="#FFFFFF"
                            TextColor="#221614"/>
                    <Button Grid.Column="1"
                            Text="+ Preventivo"
                            Clicked="OnAddQuoteClicked"
                            BackgroundColor="#B3261E"
                            TextColor="#FFFFFF"
                            CornerRadius="8"
                            Padding="14,8"/>
                </Grid>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,Auto">
                    <Label x:Name="QuoteCountLabel"
                           Text="0 preventivi"
                           FontSize="12"
                           TextColor="#7B6661"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="1"
                            Text="Aggiorna"
                            Clicked="OnRefreshQuotesClicked"
                            BackgroundColor="Transparent"
                            TextColor="#B3261E"
                            Padding="10,4"
                            HeightRequest="36"/>
                </Grid>

                <RefreshView Grid.Row="3"
                             x:Name="QuoteRefresh"
                             Refreshing="OnQuoteRefreshViewRefreshing">
                    <CollectionView x:Name="QuoteList"
                                    SelectionMode="Single"
                                    SelectionChanged="OnQuoteSelected">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20,36"
                                                 Spacing="5">
                                <Label Text="Nessun preventivo"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold"
                                       TextColor="#221614"/>
                                <Label Text="Modifica la ricerca oppure creane uno nuovo."
                                       HorizontalTextAlignment="Center"
                                       FontSize="13"
                                       TextColor="#7B6661"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#E6D6D2"
                                        StrokeThickness="1"
                                        BackgroundColor="#FFFFFF"
                                        Margin="0,0,0,10"
                                        Padding="14"
                                        StrokeShape="RoundRectangle 8">
                                    <Grid RowDefinitions="Auto,Auto,Auto"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12"
                                          RowSpacing="6">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding CustomerName}"
                                                   FontSize="19"
                                                   FontAttributes="Bold"
                                                   TextColor="#221614"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding ReferenceDisplay}"
                                                   FontSize="14"
                                                   TextColor="#7B6661"
                                                   LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1"
                                               Text="{Binding TotalDisplay}"
                                               FontSize="17"
                                               FontAttributes="Bold"
                                               TextColor="#B3261E"
                                               HorizontalTextAlignment="End"/>

                                        <Label Grid.Row="1"
                                               Text="{Binding QuoteMetaDisplay}"
                                               FontSize="12"
                                               TextColor="#7B6661"/>

                                        <Border Grid.Row="1"
                                                Grid.Column="1"
                                                StrokeThickness="0"
                                                BackgroundColor="#FCEDEA"
                                                Padding="8,3"
                                                HorizontalOptions="End"
                                                StrokeShape="RoundRectangle 6">
                                            <Label Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#B3261E"/>
                                        </Border>

                                        <BoxView Grid.Row="2"
                                                 Grid.ColumnSpan="2"
                                                 HeightRequest="1"
                                                 Margin="0,3,0,0"
                                                 BackgroundColor="#F2E7E4"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>

            <Grid x:Name="CustomersPanel"
                  IsVisible="False"
                  RowDefinitions="Auto,Auto,*"
                  RowSpacing="10">
                <SearchBar x:Name="CustomerSearchBox"
                           Placeholder="Cerca nome, indirizzo o contatto"
                           SearchButtonPressed="OnCustomerSearchRequested"
                           TextChanged="OnCustomerSearchTextChanged"
                           BackgroundColor="#FFFFFF"
                           TextColor="#221614"
                           PlaceholderColor="#7B6661"/>

                <Grid Grid.Row="1"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                    <Label x:Name="CustomerCountLabel"
                           Text="0 clienti"
                           FontSize="12"
                           TextColor="#7B6661"
                           VerticalOptions="Center"/>
                    <Button Grid.Column="1"
                            Text="+ Cliente"
                            Clicked="OnAddCustomerClicked"
                            BackgroundColor="#B3261E"
                            TextColor="#FFFFFF"
                            CornerRadius="8"
                            Padding="16,8"/>
                </Grid>

                <RefreshView Grid.Row="2"
                             x:Name="CustomerRefresh"
                             Refreshing="OnCustomerRefreshViewRefreshing">
                    <CollectionView x:Name="CustomerList"
                                    SelectionMode="Single"
                                    SelectionChanged="OnCustomerSelected">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="20,36"
                                                 Spacing="5">
                                <Label Text="Nessun cliente"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold"
                                       TextColor="#221614"/>
                                <Label Text="Modifica la ricerca oppure aggiungi un cliente."
                                       HorizontalTextAlignment="Center"
                                       FontSize="13"
                                       TextColor="#7B6661"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#E6D6D2"
                                        StrokeThickness="1"
                                        BackgroundColor="#FFFFFF"
                                        Margin="0,0,0,10"
                                        Padding="14"
                                        StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding BusinessName}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#221614"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding AddressDisplay}"
                                               FontSize="13"
                                               TextColor="#7B6661"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding ContactDisplay}"
                                               FontSize="13"
                                               TextColor="#7B6661"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding DiscountsDisplay}"
                                               Margin="0,3,0,0"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#B3261E"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>

            <ActivityIndicator x:Name="Busy"
                               IsVisible="False"
                               IsRunning="False"
                               Color="#B3261E"
                               WidthRequest="44"
                               HeightRequest="44"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>
